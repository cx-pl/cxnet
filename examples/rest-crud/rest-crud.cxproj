name: RestCrudExample
version: 0.1.0
type: Executable
project_references:
- ../../src/cxnet.cxproj
- ../../../cxdata/src/cxdata.cxproj
generators:
- id: cxnet-rest
  executable: ../../generators/rest/.bin/Release/CxnetRestGenerator.exe
- id: cxdata-json
  executable: ../../../cxdata-json-generator/src/.bin/Release/CxDataJsonGenerator.exe
  timeout_seconds: 180
