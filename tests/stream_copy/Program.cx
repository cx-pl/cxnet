public class PendingReadStream : Stream {
    public override bool CanRead { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task<uint> ReadAsync(byte[] buffer, uint offset,
        uint count, CancellationToken cancellationToken) {
        Task<uint> pendingRead = new Task<uint>();
        cancellationToken.Register(() => pendingRead.SetCanceled());
        return pendingRead;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { }
}

public class LateDataReadStream : Stream {
    private Task<uint> _pendingRead;
    private byte[] _buffer;
    private uint _offset;
    private uint _readCalls;

    public uint ReadCalls { get { return _readCalls; } }

    public override bool CanRead { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task<uint> ReadAsync(byte[] buffer, uint offset,
        uint count, CancellationToken cancellationToken) {
        _readCalls += 1u;
        _buffer = buffer;
        _offset = offset;
        _pendingRead = new Task<uint>();
        return _pendingRead;
    }
    public void CompleteWithByte(uint value) {
        _buffer[_offset] = (byte)value;
        _pendingRead.SetResult(1u);
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { }
}

public class CountingWriteStream : Stream {
    private uint _writeCalls;

    public uint WriteCalls { get { return _writeCalls; } }

    public override bool CanWrite { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        _writeCalls += 1u;
    }
    public override Task WriteAsync(byte[] buffer, uint offset, uint count,
        CancellationToken cancellationToken) {
        _writeCalls += 1u;
        Task completedWrite = new Task();
        completedWrite.SetResult();
        return completedWrite;
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { }
}

public class OneByteReadStream : Stream {
    private uint _readCalls;

    public uint ReadCalls { get { return _readCalls; } }

    public override bool CanRead { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task<uint> ReadAsync(byte[] buffer, uint offset,
        uint count, CancellationToken cancellationToken) {
        _readCalls += 1u;
        Task<uint> result = new Task<uint>();
        if (_readCalls == 1u) {
            buffer[offset] = (byte)0x5Cu;
            result.SetResult(1u);
        } else {
            result.SetResult(0u);
        }
        return result;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { }
}

public class DisposeAwareOneByteReadStream : Stream {
    private uint _readCalls;
    private uint _disposeCount;
    public AtomicInt Disposed;

    public uint ReadCalls { get { return _readCalls; } }
    public uint DisposeCount { get { return _disposeCount; } }

    public constructor() { Disposed = new AtomicInt(0); }

    public override bool CanRead { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task<uint> ReadAsync(byte[] buffer, uint offset,
        uint count, CancellationToken cancellationToken) {
        _readCalls += 1u;
        if (Disposed.Value != 0)
            throw new ObjectDisposedException("DisposeAwareOneByteReadStream");
        Task<uint> result = new Task<uint>();
        if (_readCalls == 1u) {
            buffer[offset] = (byte)0x6Bu;
            result.SetResult(1u);
        } else {
            result.SetResult(0u);
        }
        return result;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() {
        _disposeCount += 1u;
        Disposed.Exchange(1);
    }
}

public class PendingWriteStream : Stream {
    private TaskCompletionSource _pendingWrite;
    private uint _writeCalls;

    public Task PendingWrite {
        get { return _pendingWrite == null ? null : _pendingWrite.Task; }
    }
    public uint WriteCalls { get { return _writeCalls; } }

    public override bool CanWrite { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task WriteAsync(byte[] buffer, uint offset, uint count,
        CancellationToken cancellationToken) {
        _writeCalls += 1u;
        _pendingWrite = new TaskCompletionSource();
        return _pendingWrite.Task;
    }
    public void CompleteWrite() { _pendingWrite.SetResult(); }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { }
}

public class DisposePendingWriteStream : Stream {
    private TaskCompletionSource _pendingWrite;
    private bool _disposed;
    private uint _disposeCount;
    private uint _writeCalls;

    public Task PendingWrite {
        get { return _pendingWrite == null ? null : _pendingWrite.Task; }
    }
    public uint DisposeCount { get { return _disposeCount; } }
    public uint WriteCalls { get { return _writeCalls; } }

    public override bool CanWrite { get { return !_disposed; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task WriteAsync(byte[] buffer, uint offset, uint count,
        CancellationToken cancellationToken) {
        _writeCalls += 1u;
        _pendingWrite = new TaskCompletionSource();
        return _pendingWrite.Task;
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() {
        if (_disposed) return;
        _disposed = true;
        _disposeCount += 1u;
        if (_pendingWrite != null && !_pendingWrite.Task.IsCompleted) {
            _pendingWrite.SetException(
                new ObjectDisposedException("DisposePendingWriteStream"));
        }
    }
}

public class DisposeDuringReadStream : Stream {
    private Task<uint> _pendingRead;
    private uint _disposeCount;

    public uint DisposeCount { get { return _disposeCount; } }
    public bool ReadPending {
        get { return _pendingRead != null && !_pendingRead.IsCompleted; }
    }

    public override bool CanRead { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task<uint> ReadAsync(byte[] buffer, uint offset,
        uint count, CancellationToken cancellationToken) {
        _pendingRead = new Task<uint>();
        return _pendingRead;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() {
        _disposeCount += 1u;
        if (_pendingRead != null && !_pendingRead.IsCompleted) {
            _pendingRead.SetFault(
                new ObjectDisposedException("DisposeDuringReadStream"));
        }
    }
}

public class TrackedMemoryStream : Stream {
    private MemoryStream _inner;
    public AtomicInt DisposeCount;

    public constructor() {
        _inner = new MemoryStream();
        DisposeCount = new AtomicInt(0);
    }

    public override bool CanRead { get => true; }
    public override bool CanWrite { get => true; }
    public override bool CanSeek { get => true; }
    public override long Length { get => _inner.Length; }
    public override long Position {
        get => _inner.Position;
        set => _inner.Position = value;
    }
    public override void Flush() { _inner.Flush(); }
    public override int Read(byte[] buffer, uint offset, uint count) {
        return _inner.Read(buffer, offset, count);
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        _inner.Write(buffer, offset, count);
    }
    public override long Seek(long offset, SeekOrigin origin) {
        return _inner.Seek(offset, origin);
    }
    public override void SetLength(long value) { _inner.SetLength(value); }

    public override void Dispose() {
        DisposeCount.Increment();
        _inner.Dispose();
    }
}

public class StreamContentReadDisposeRace {
    public StreamContent Content;
    public byte[] Expected;
    public AtomicInt Start;
    public AtomicInt ReadStarted;
    public AtomicInt Outcome;

    public constructor(StreamContent content, byte[] expected) {
        Content = content;
        Expected = expected;
        Start = new AtomicInt(0);
        ReadStarted = new AtomicInt(0);
        Outcome = new AtomicInt(0);
    }

    public void Read() {
        while (Start.Value == 0) Thread.Yield();
        ReadStarted.Exchange(1);
        try {
            byte[] actual = Content.ReadAsByteArray();
            if (actual.Length == Expected.Length &&
                actual[0u] == Expected[0u] &&
                actual[Expected.Length / 2u] == Expected[Expected.Length / 2u] &&
                actual[Expected.Length - 1u] == Expected[Expected.Length - 1u]) {
                Outcome.Exchange(1);
            } else {
                Outcome.Exchange(2);
            }
        } catch (ObjectDisposedException) {
            Outcome.Exchange(3);
        } catch (Exception) {
            Outcome.Exchange(4);
        }
    }
}

public class StreamCopyWriteDisposeRace {
    public StreamContent Content;
    public CancellationTokenSource Cancellation;
    public AtomicInt Start;
    public AtomicInt DisposeFailed;

    public constructor(StreamContent content,
        CancellationTokenSource cancellation) {
        Content = content;
        Cancellation = cancellation;
        Start = new AtomicInt(0);
        DisposeFailed = new AtomicInt(0);
    }

    public void DisposeAndCancel() {
        while (Start.Value == 0) Thread.Yield();
        try {
            Content.Dispose();
            Cancellation.Cancel();
        } catch (Exception) {
            DisposeFailed.Exchange(1);
        }
    }
}

public class DataThenPendingEofStream : Stream {
    private uint _readCount;
    private Task<uint> _pendingEofRead;

    public Task<uint> PendingEofRead {
        get { return _pendingEofRead; }
    }

    public override bool CanRead { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override Task<uint> ReadAsync(byte[] buffer, uint offset,
        uint count, CancellationToken cancellationToken) {
        _readCount += 1u;
        if (_readCount == 1u) {
            buffer[offset] = (byte)0x7Au;
            Task<uint> dataRead = new Task<uint>();
            dataRead.SetResult(1u);
            return dataRead;
        }
        _pendingEofRead = new Task<uint>();
        return _pendingEofRead;
    }
    public void CompleteEof() {
        _pendingEofRead.SetResult(0u);
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { }
}

public class NonSeekablePayloadStream : Stream {
    private byte[] _bytes;
    private uint _position;

    public constructor(byte[] bytes) {
        _bytes = bytes;
        _position = 0u;
    }

    public override bool CanRead { get { return true; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        uint available = _position < _bytes.Length
            ? _bytes.Length - _position : 0u;
        uint copied = count < available ? count : available;
        for (uint index = 0u; index < copied; index += 1u) {
            buffer[offset + index] = _bytes[_position + index];
        }
        _position += copied;
        return (int)copied;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { }
}

public bool Finish(Task pending) {
    uint steps = 0u;
    while (!pending.IsCompleted && steps < 10000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    return pending.IsCompleted;
}

public bool IsIoFault(Task pending) {
    if (!pending.IsCompleted || !pending.IsFaulted || pending.IsCanceled) {
        return false;
    }
    try {
        pending.GetResult();
    } catch (IOException) {
        return true;
    } catch (Exception) { }
    return false;
}

public bool IsCanceled(Task pending) {
    if (!pending.IsCompleted || pending.IsFaulted || !pending.IsCanceled) {
        return false;
    }
    try {
        pending.GetResult();
    } catch (OperationCanceledException) {
        return true;
    } catch (Exception) { }
    return false;
}

public bool FinishBytes(Task<byte[]> pending) {
    uint steps = 0u;
    while (!pending.IsCompleted && steps < 10000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    return pending.IsCompleted;
}

public bool IsIoFault(Task<byte[]> pending) {
    if (!pending.IsCompleted || !pending.IsFaulted || pending.IsCanceled) {
        return false;
    }
    try {
        byte[] unexpected = pending.GetResult();
    } catch (IOException) {
        return true;
    } catch (Exception) { }
    return false;
}

