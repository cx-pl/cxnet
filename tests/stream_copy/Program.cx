public bool HasBytes(MemoryStream stream, uint first, uint second,
    uint third) {
    byte[] actual = stream.ToArray();
    return actual.Length == 3u && (uint)actual[0u] == first &&
        (uint)actual[1u] == second && (uint)actual[2u] == third;
}

public bool HasFourBytes(MemoryStream stream) {
    byte[] actual = stream.ToArray();
    return actual.Length == 4u && (uint)actual[0u] == 0x10u &&
        (uint)actual[1u] == 0x20u && (uint)actual[2u] == 0x30u &&
        (uint)actual[3u] == 0x40u;
}

public bool HasOneByte(MemoryStream stream, uint expected) {
    byte[] actual = stream.ToArray();
    return actual.Length == 1u && (uint)actual[0u] == expected;
}

public bool WaitForPendingEofRead(DataThenPendingEofStream source) {
    uint steps = 0u;
    while (source.PendingEofRead == null && steps < 10000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    return source.PendingEofRead != null;
}

public bool WaitForPendingWrite(PendingWriteStream destination) {
    uint steps = 0u;
    while (destination.PendingWrite == null && steps < 10000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    return destination.PendingWrite != null;
}

public bool WaitForPendingWrite(DisposePendingWriteStream destination) {
    uint steps = 0u;
    while (destination.PendingWrite == null && steps < 10000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    return destination.PendingWrite != null;
}

public byte[] FourBytes() {
    byte[] bytes = new byte[4u];
    bytes[0u] = (byte)0x10u;
    bytes[1u] = (byte)0x20u;
    bytes[2u] = (byte)0x30u;
    bytes[3u] = (byte)0x40u;
    return bytes;
}

public byte[] OneByte(uint value) {
    byte[] bytes = new byte[1u];
    bytes[0u] = (byte)value;
    return bytes;
}

public int Main(string[] args) {
    Task nullDestinationCopy = new MemoryStream(FourBytes()).CopyToAsync(null);
    if (!Finish(nullDestinationCopy) ||
        !IsArgumentNullFault(nullDestinationCopy)) return 51;

    MemoryStream writableCheckSource = new MemoryStream(FourBytes());
    MemoryStream closedDestination = new MemoryStream();
    closedDestination.Dispose();
    Task closedDestinationCopy = writableCheckSource.CopyToAsync(
        closedDestination);
    if (!Finish(closedDestinationCopy) ||
        !IsArgumentFault(closedDestinationCopy)) return 52;

    MemoryStream closedSource = new MemoryStream(FourBytes());
    closedSource.Dispose();
    Task closedSourceCopy = closedSource.CopyToAsync(new MemoryStream());
    if (!Finish(closedSourceCopy) ||
        !IsNotSupportedFault(closedSourceCopy)) return 53;

    MemoryStream source = new MemoryStream(FourBytes());
    source.Position = 1L;
    MemoryStream destination = new MemoryStream();
    if (!source.CanRead || !destination.CanWrite) {
        Console.WriteLine("memory stream capability check failed");
        return 10;
    }
    Task copied = source.CopyToAsync(destination);
    if (!Finish(copied)) return 11;
    if (copied.IsFaulted) {
        try { copied.GetResult(); }
        catch (Exception exception) {
            Console.WriteLine(exception.Message);
            return 12;
        }
    }
    if (copied.IsCanceled || !HasBytes(destination, 0x20u, 0x30u, 0x40u)) {
        return 1;
    }

    MemoryStream contentSource = new MemoryStream(FourBytes());
    contentSource.Position = 1L;
    StreamContent content = new StreamContent(contentSource, 16u, true);
    MemoryStream contentDestination = new MemoryStream();
    Task contentCopy = content.CopyToAsync(contentDestination);
    if (!Finish(contentCopy) || contentCopy.IsFaulted ||
        contentCopy.IsCanceled ||
        !HasBytes(contentDestination, 0x20u, 0x30u, 0x40u)) return 2;
    content.Dispose();

    MemoryStream replaySource = new MemoryStream(FourBytes());
    replaySource.Position = 1L;
    StreamContent replayable = new StreamContent(replaySource, 16u, true);
    byte[] firstBuffer = replayable.ReadAsByteArray();
    byte[] repeatedBuffer = replayable.ReadAsByteArray();
    if (firstBuffer.Length != 3u || repeatedBuffer.Length != 3u ||
        (uint)firstBuffer[0u] != 0x20u ||
        (uint)repeatedBuffer[2u] != 0x40u) return 8;
    replayable.Dispose();

    MemoryStream limitedSource = new MemoryStream(FourBytes());
    limitedSource.Position = 1L;
    StreamContent limitedContent = new StreamContent(limitedSource, 2u, true);
    Task<byte[]> limitedRead = limitedContent.ReadAsByteArrayAsync();
    if (!FinishBytes(limitedRead) || !IsIoFault(limitedRead) ||
        limitedSource.Position != 1L) return 9;
    limitedContent.Dispose();

    NonSeekablePayloadStream nonSeekableSource =
        new NonSeekablePayloadStream(FourBytes());
    StreamContent streamingContent = new StreamContent(
        nonSeekableSource, 16u, true);
    MemoryStream streamingDestination = new MemoryStream();
    Task streamingCopy = streamingContent.CopyToAsync(streamingDestination);
    if (!Finish(streamingCopy) || streamingCopy.IsFaulted ||
        streamingCopy.IsCanceled || !HasFourBytes(streamingDestination)) return 10;
    Task<byte[]> replayOfStream = streamingContent.ReadAsByteArrayAsync();
    if (!FinishBytes(replayOfStream) || !IsIoFault(replayOfStream)) return 11;
    streamingContent.Dispose();

    DisposeDuringReadStream disposingSource = new DisposeDuringReadStream();
    StreamContent disposingContent = new StreamContent(
        disposingSource, 16u, false);
    Task<byte[]> pendingBuffer = disposingContent.ReadAsByteArrayAsync();
    if (pendingBuffer.IsCompleted) return 12;
    Task<byte[]> cachedBufferTask = disposingContent.ReadAsByteArrayAsync();
    if (cachedBufferTask != pendingBuffer) return 16;
    disposingContent.Dispose();
    disposingContent.Dispose();
    if (!FinishBytes(pendingBuffer)) return 13;
    if (!IsCanceled(pendingBuffer)) return 14;
    if (disposingSource.DisposeCount != 1u) return 15;

    DisposeDuringReadStream disposingCopySource =
        new DisposeDuringReadStream();
    StreamContent disposingCopyContent = new StreamContent(
        disposingCopySource, 16u, false);
    Task pendingStreamContentCopy = disposingCopyContent.CopyToAsync(
        new MemoryStream());
    if (!disposingCopySource.ReadPending || pendingStreamContentCopy.IsCompleted)
        return 34;
    disposingCopyContent.Dispose();
    disposingCopyContent.Dispose();
    if (disposingCopySource.DisposeCount != 1u ||
        !Finish(pendingStreamContentCopy) ||
        !pendingStreamContentCopy.IsFaulted ||
        pendingStreamContentCopy.IsCanceled) return 35;
    bool disposeDuringCopyReadFaultObserved = false;
    try {
        pendingStreamContentCopy.GetResult();
    } catch (ObjectDisposedException) {
        disposeDuringCopyReadFaultObserved = true;
    }
    if (!disposeDuringCopyReadFaultObserved ||
        disposingCopySource.DisposeCount != 1u) return 36;

    CancellationTokenSource eofCancellation = new CancellationTokenSource();
    DataThenPendingEofStream eofSource = new DataThenPendingEofStream();
    MemoryStream eofDestination = new MemoryStream();
    Task eofCopy = eofSource.CopyToAsync(eofDestination,
        eofCancellation.Token);
    if (!WaitForPendingEofRead(eofSource) ||
        !HasOneByte(eofDestination, 0x7Au) || eofCopy.IsCompleted) return 17;
    eofCancellation.Cancel();
    eofSource.CompleteEof();
    if (!Finish(eofCopy) || !IsCanceled(eofCopy)) return 18;

    OverReportingStream overReportingCopySource = new OverReportingStream();
    Task overReportedCopy = overReportingCopySource.CopyToAsync(
        new MemoryStream());
    if (!Finish(overReportedCopy) ||
        !IsInvalidOperationFault(overReportedCopy)) return 19;

    StreamContent overReportingContent = new StreamContent(
        new OverReportingStream(), 16u, true);
    Task<byte[]> overReportedBuffer =
        overReportingContent.ReadAsByteArrayAsync();
    if (!FinishBytes(overReportedBuffer) ||
        !IsInvalidOperationFault(overReportedBuffer)) return 20;
    overReportingContent.Dispose();

    AsyncReadSetupFailureStream asyncMaterializationSource =
        new AsyncReadSetupFailureStream();
    StreamContent asyncMaterializationContent = new StreamContent(
        asyncMaterializationSource, 16u, false);
    Task<byte[]> asyncMaterializationFailure =
        asyncMaterializationContent.ReadAsByteArrayAsync();
    if (!FinishBytes(asyncMaterializationFailure) ||
        !IsIoFault(asyncMaterializationFailure)) return 44;
    Task<byte[]> retryAfterSetupFailure =
        asyncMaterializationContent.ReadAsByteArrayAsync();
    if (retryAfterSetupFailure != asyncMaterializationFailure ||
        !IsIoFault(retryAfterSetupFailure) ||
        asyncMaterializationSource.DisposeCount != 0u) return 45;
    asyncMaterializationContent.Dispose();
    asyncMaterializationContent.Dispose();
    if (asyncMaterializationSource.DisposeCount != 1u) return 46;

    StreamContent throwingContinuationContent = new StreamContent(
        new OverReportingStream(), 16u, true);
    Task<byte[]> throwingContinuationBuffer =
        throwingContinuationContent.ReadAsByteArrayAsync();
    bool continuationThrew = false;
    throwingContinuationBuffer.OnCompleted(() => {
        throw new InvalidOperationException("injected completion continuation failure");
    });
    uint continuationSteps = 0u;
    while (!continuationThrew && continuationSteps < 10000u) {
        try {
            if (!TaskScheduler.RunOne()) break;
        } catch (InvalidOperationException) {
            continuationThrew = true;
        }
        continuationSteps += 1u;
    }
    if (!continuationThrew ||
        !IsInvalidOperationFault(throwingContinuationBuffer)) {
        Console.WriteLine("throwing continuation did not leave a faulted materialization task");
        return 21;
    }
    Task<byte[]> retryAfterContinuationFailure =
        throwingContinuationContent.ReadAsByteArrayAsync();
    if (retryAfterContinuationFailure != throwingContinuationBuffer ||
        !IsInvalidOperationFault(retryAfterContinuationFailure)) {
        Console.WriteLine("throwing continuation changed the cached materialization result");
        return 22;
    }
    throwingContinuationContent.Dispose();

    ReadFailureStream failingSource = new ReadFailureStream();
    MemoryStream failureDestination = new MemoryStream();
    Task readFailure = failingSource.CopyToAsync(failureDestination);
    if (!Finish(readFailure) || !IsIoFault(readFailure)) return 3;

    AsyncReadSetupFailureStream asyncSetupFailingSource =
        new AsyncReadSetupFailureStream();
    Task asyncReadSetupFailure = asyncSetupFailingSource.CopyToAsync(
        new MemoryStream());
    if (!Finish(asyncReadSetupFailure) || !IsIoFault(asyncReadSetupFailure))
        return 26;

    Task nullReadTask = new NullReadTaskStream().CopyToAsync(
        new MemoryStream());
    if (!Finish(nullReadTask) || !IsInvalidOperationFault(nullReadTask))
        return 37;

    MemoryStream writeSource = new MemoryStream(OneByte(0x55u));
    WriteFailureStream failingDestination = new WriteFailureStream();
    Task writeFailure = writeSource.CopyToAsync(failingDestination);
    if (!Finish(writeFailure) || !IsIoFault(writeFailure)) return 4;

    OneByteReadStream destinationDisposeSource = new OneByteReadStream();
    DisposePendingWriteStream disposedDestination =
        new DisposePendingWriteStream();
    Task destinationDisposeCopy = destinationDisposeSource.CopyToAsync(
        disposedDestination);
    if (!WaitForPendingWrite(disposedDestination) ||
        destinationDisposeCopy.IsCompleted ||
        destinationDisposeSource.ReadCalls != 1u ||
        disposedDestination.WriteCalls != 1u) return 54;
    disposedDestination.Dispose();
    disposedDestination.Dispose();
    if (!Finish(destinationDisposeCopy) ||
        !destinationDisposeCopy.IsFaulted ||
        destinationDisposeCopy.IsCanceled ||
        destinationDisposeSource.ReadCalls != 1u ||
        disposedDestination.WriteCalls != 1u ||
        disposedDestination.DisposeCount != 1u) return 55;
    bool destinationDisposeFaultObserved = false;
    try {
        destinationDisposeCopy.GetResult();
    } catch (ObjectDisposedException) {
        destinationDisposeFaultObserved = true;
    }
    if (!destinationDisposeFaultObserved) return 56;

    AsyncWriteSetupFailureStream asyncSetupFailingDestination =
        new AsyncWriteSetupFailureStream();
    Task asyncWriteSetupFailure = new MemoryStream(OneByte(0x67u))
        .CopyToAsync(asyncSetupFailingDestination);
    if (!Finish(asyncWriteSetupFailure) || !IsIoFault(asyncWriteSetupFailure))
        return 27;

    Task nullWriteTask = new MemoryStream(OneByte(0x68u)).CopyToAsync(
        new NullWriteTaskStream());
    if (!Finish(nullWriteTask) || !IsInvalidOperationFault(nullWriteTask))
        return 38;

    CancellationTokenSource cancellation = new CancellationTokenSource();
    cancellation.Cancel();
    MemoryStream canceledSource = new MemoryStream(OneByte(0x66u));
    MemoryStream canceledDestination = new MemoryStream();
    Task canceled = canceledSource.CopyToAsync(canceledDestination,
        cancellation.Token);
    if (!Finish(canceled) || !IsCanceled(canceled)) return 5;

    CancellationTokenSource pendingCancellation = new CancellationTokenSource();
    PendingReadStream pendingSource = new PendingReadStream();
    MemoryStream pendingDestination = new MemoryStream();
    Task pendingCopy = pendingSource.CopyToAsync(pendingDestination,
        pendingCancellation.Token);
    if (pendingCopy.IsCompleted) return 6;
    pendingCancellation.Cancel();
    if (!Finish(pendingCopy) || !IsCanceled(pendingCopy)) return 7;

    CancellationTokenSource lateReadCancellation =
        new CancellationTokenSource();
    LateDataReadStream lateDataSource = new LateDataReadStream();
    CountingWriteStream lateDataDestination = new CountingWriteStream();
    Task lateDataCopy = lateDataSource.CopyToAsync(lateDataDestination,
        lateReadCancellation.Token);
    if (lateDataCopy.IsCompleted || lateDataSource.ReadCalls != 1u ||
        lateDataDestination.WriteCalls != 0u) return 47;
    lateReadCancellation.Cancel();
    lateDataSource.CompleteWithByte(0x73u);
    if (!Finish(lateDataCopy) || !IsCanceled(lateDataCopy) ||
        lateDataSource.ReadCalls != 1u ||
        lateDataDestination.WriteCalls != 0u) return 48;

    CancellationTokenSource writeCancellation = new CancellationTokenSource();
    OneByteReadStream writePendingSource = new OneByteReadStream();
    StreamContent writePendingContent = new StreamContent(
        writePendingSource, 16u, true);
    PendingWriteStream writePendingDestination = new PendingWriteStream();
    Task writePendingCopy = writePendingContent.CopyToAsync(
        writePendingDestination, writeCancellation.Token);
    if (!WaitForPendingWrite(writePendingDestination) ||
        writePendingCopy.IsCompleted || writePendingSource.ReadCalls != 1u ||
        writePendingDestination.WriteCalls != 1u) return 23;
    writeCancellation.Cancel();
    if (writePendingCopy.IsCompleted) return 24;
    writePendingDestination.CompleteWrite();
    if (!Finish(writePendingCopy) || !IsCanceled(writePendingCopy) ||
        writePendingSource.ReadCalls != 1u ||
        writePendingDestination.WriteCalls != 1u) return 25;
    writePendingContent.Dispose();

    CancellationTokenSource overlappingWriteCancellation =
        new CancellationTokenSource();
    DisposeAwareOneByteReadStream overlappingWriteSource =
        new DisposeAwareOneByteReadStream();
    StreamContent overlappingWriteContent = new StreamContent(
        overlappingWriteSource, 16u, false);
    PendingWriteStream overlappingWriteDestination = new PendingWriteStream();
    Task overlappingWriteCopy = overlappingWriteContent.CopyToAsync(
        overlappingWriteDestination, overlappingWriteCancellation.Token);
    if (!WaitForPendingWrite(overlappingWriteDestination) ||
        overlappingWriteCopy.IsCompleted ||
        overlappingWriteSource.ReadCalls != 1u ||
        overlappingWriteDestination.WriteCalls != 1u) return 41;
    overlappingWriteContent.Dispose();
    overlappingWriteCancellation.Cancel();
    if (overlappingWriteCopy.IsCompleted ||
        overlappingWriteSource.DisposeCount != 1u) return 42;
    overlappingWriteDestination.CompleteWrite();
    if (!Finish(overlappingWriteCopy) || !IsCanceled(overlappingWriteCopy) ||
        overlappingWriteSource.ReadCalls != 1u ||
        overlappingWriteDestination.WriteCalls != 1u ||
        overlappingWriteSource.DisposeCount != 1u) return 43;

    DisposeAwareOneByteReadStream disposedDuringWriteSource =
        new DisposeAwareOneByteReadStream();
    StreamContent disposedDuringWriteContent = new StreamContent(
        disposedDuringWriteSource, 16u, false);
    PendingWriteStream disposedDuringWriteDestination = new PendingWriteStream();
    Task disposedDuringWriteCopy = disposedDuringWriteContent.CopyToAsync(
        disposedDuringWriteDestination, CancellationToken.None);
    if (!WaitForPendingWrite(disposedDuringWriteDestination) ||
        disposedDuringWriteCopy.IsCompleted ||
        disposedDuringWriteSource.ReadCalls != 1u ||
        disposedDuringWriteDestination.WriteCalls != 1u) return 30;
    disposedDuringWriteContent.Dispose();
    if (disposedDuringWriteSource.DisposeCount != 1u ||
        disposedDuringWriteCopy.IsCompleted) return 31;
    disposedDuringWriteDestination.CompleteWrite();
    if (!Finish(disposedDuringWriteCopy) ||
        !disposedDuringWriteCopy.IsFaulted ||
        disposedDuringWriteCopy.IsCanceled ||
        disposedDuringWriteSource.ReadCalls != 2u ||
        disposedDuringWriteDestination.WriteCalls != 1u) return 32;
    bool disposeDuringWriteFaultObserved = false;
    try {
        disposedDuringWriteCopy.GetResult();
    } catch (ObjectDisposedException) {
        disposeDuringWriteFaultObserved = true;
    }
    if (!disposeDuringWriteFaultObserved ||
        disposedDuringWriteSource.DisposeCount != 1u) return 33;

    for (uint round = 0u; round < 24u; round += 1u) {
        CancellationTokenSource completionDisposeCancellation =
            new CancellationTokenSource();
        DisposeAwareOneByteReadStream completionDisposeSource =
            new DisposeAwareOneByteReadStream();
        StreamContent completionDisposeContent = new StreamContent(
            completionDisposeSource, 16u, false);
        PendingWriteStream completionDisposeDestination =
            new PendingWriteStream();
        Task completionDisposeCopy = completionDisposeContent.CopyToAsync(
            completionDisposeDestination,
            completionDisposeCancellation.Token);
        if (!WaitForPendingWrite(completionDisposeDestination) ||
            completionDisposeCopy.IsCompleted ||
            completionDisposeSource.ReadCalls != 1u ||
            completionDisposeDestination.WriteCalls != 1u) return 49;
        StreamCopyWriteDisposeRace completionDisposeRace =
            new StreamCopyWriteDisposeRace(completionDisposeContent,
                completionDisposeCancellation);
        Thread contentDisposer = Thread.Start(
            () => completionDisposeRace.DisposeAndCancel());
        completionDisposeRace.Start.Exchange(1);
        completionDisposeDestination.CompleteWrite();
        contentDisposer.Join();
        if (completionDisposeRace.DisposeFailed.Value != 0) {
            Console.WriteLine("Dispose/cancel worker failed");
            return 50;
        }
        if (completionDisposeSource.DisposeCount != 1u) {
            Console.WriteLine("Disposed source was not disposed exactly once");
            return 50;
        }
        if (!Finish(completionDisposeCopy)) {
            Console.WriteLine("Copy did not complete after write/dispose race");
            return 50;
        }
        if (completionDisposeCopy.IsCanceled) {
            if (completionDisposeSource.ReadCalls != 1u) {
                Console.WriteLine(
                    "Copy started another source read after cancellation");
                return 50;
            }
        } else if (completionDisposeCopy.IsFaulted) {
            bool disposedFault = false;
            try {
                completionDisposeCopy.GetResult();
            } catch (ObjectDisposedException) {
                disposedFault = true;
            } catch (Exception) { }
            if (!disposedFault || completionDisposeSource.ReadCalls != 2u) {
                Console.WriteLine(
                    "Copy produced an invalid fault in write/dispose race");
                return 50;
            }
        } else if (completionDisposeSource.ReadCalls != 2u) {
            Console.WriteLine("Copy completed with an invalid read count");
            return 50;
        }
        if (completionDisposeDestination.WriteCalls != 1u) {
            Console.WriteLine("Copy started another destination write");
            return 50;
        }
    }

    byte[] disposeRaceBytes = new byte[4194304u];
    for (uint index = 0u; index < disposeRaceBytes.Length; index += 1u) {
        disposeRaceBytes[index] = (byte)(index * 29u + 11u);
    }
    for (uint round = 0u; round < 12u; round += 1u) {
        TrackedMemoryStream disposeRaceSource = new TrackedMemoryStream();
        disposeRaceSource.Write(disposeRaceBytes, 0u, disposeRaceBytes.Length);
        disposeRaceSource.Position = 0L;
        StreamContent disposeRaceContent = new StreamContent(
            disposeRaceSource, disposeRaceBytes.Length, false);
        StreamContentReadDisposeRace disposeRace =
            new StreamContentReadDisposeRace(
                disposeRaceContent, disposeRaceBytes);
        Thread reader = Thread.Start(() => disposeRace.Read());
        disposeRace.Start.Exchange(1);
        uint startSteps = 0u;
        while (disposeRace.ReadStarted.Value == 0 && startSteps < 100000u) {
            Thread.Yield();
            startSteps += 1u;
        }
        disposeRaceContent.Dispose();
        reader.Join();
        if (startSteps == 100000u ||
            (disposeRace.Outcome.Value != 1 && disposeRace.Outcome.Value != 3) ||
            disposeRaceSource.DisposeCount.Value != 1) return 28;
    }
    return 0;
}
