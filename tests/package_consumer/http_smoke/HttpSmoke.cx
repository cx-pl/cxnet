import System;
import System.Net.Http;
import System.Threading.Tasks;
import M26Consumer;

namespace M26PackageHttpSmoke;

public int Main(string[] args) {
    if (args.Length < 3u || args.Length > 4u) {
        Console.WriteLine(
            "usage: M26PackageHttpSmoke <url> <expected-body> <ca-file> " +
            "[expect-tls-failure]");
        return 2;
    }

    bool expectTlsFailure = args.Length == 4u &&
        args[3u] == "expect-tls-failure";
    HttpConsumer consumer = new HttpConsumer();
    // The local Schannel fixture has no revocation endpoint. The handler keeps
    // chain and hostname validation enabled while treating unavailable status
    // as best effort for this test certificate.
    HttpClient client = consumer.CreateClient(args[2u], true);
    HttpResponseMessage response = null;
    try {
        Task<HttpResponseMessage> responseTask = client.GetAsync(
            new Uri(args[0u]));
        try {
            TaskScheduler.RunUntil(responseTask);
            response = responseTask.GetResult();
        } catch (Exception) {
            if (!expectTlsFailure) throw;
            Console.WriteLine("package-only HTTPS rejection passed");
            return 0;
        }
        if (expectTlsFailure) return 5;
        if (response.StatusCode != HttpStatusCode.OK) return 3;

        Task<string> bodyTask = response.Content.ReadAsStringAsync();
        TaskScheduler.RunUntil(bodyTask);
        if (bodyTask.GetResult() != args[1u]) return 4;

        Console.WriteLine("package-only HTTP GET passed");
        return 0;
    } finally {
        if (response != null) response.Dispose();
        client.Dispose();
    }
}
