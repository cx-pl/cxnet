public static bool HasUnsignedMap(
    const Dictionary<string, ulong?> values) {
    if (values.Count != 3u) return false;
    ulong? zero = values.GetValueOrDefault("zero");
    ulong? maximum = values.GetValueOrDefault("maximum");
    ulong? missing = values.GetValueOrDefault("missing");
    return zero != null && (zero ?? 1ul) == 0ul &&
        maximum != null &&
        (maximum ?? 0ul) == 18446744073709551615ul && missing == null;
}

public static bool HasNullableDtoMap(
    const Dictionary<string, RestItem?> values, int expectedQuantity) {
    RestItem? item = values.GetValueOrDefault("item");
    RestItem? missing = values.GetValueOrDefault("missing");
    return values.Count == 2u && item != null &&
        (item ?? new RestItem()).Name == "map item" &&
        (item ?? new RestItem()).Quantity == expectedQuantity && missing == null;
}

public static bool HasIntSequence(IEnumerable<int> values,
    int first, int second, int third) {
    uint index = 0u;
    foreach (int value in values) {
        if (index == 0u && value != first) return false;
        if (index == 1u && value != second) return false;
        if (index == 2u && value != third) return false;
        if (index > 2u) return false;
        index += 1u;
    }
    return index == 3u;
}

public static bool HasListMap(
    const Dictionary<string, const List<int>> values,
    int first, int second, int third) {
    const List<int> numbers = values.GetValueOrDefault("numbers");
    const List<int> empty = values.GetValueOrDefault("empty");
    List<int> emptyValues = empty ?? new List<int>();
    return values.Count == 2u && numbers != null && empty != null &&
        HasIntSequence(numbers, first, second, third) &&
        emptyValues.Count == 0u;
}

public static bool HasNullableListMap(
    const Dictionary<string, const List<int>?> values,
    int first, int second, int third) {
    const List<int>? numbers = values.GetValueOrDefault("numbers");
    const List<int>? empty = values.GetValueOrDefault("empty");
    const List<int>? missing = values.GetValueOrDefault("missing");
    List<int> numberValues = numbers ?? new List<int>();
    List<int> emptyValues = empty ?? new List<int>();
    return values.Count == 3u && numbers != null && empty != null &&
        missing == null && HasIntSequence(numberValues, first, second, third) &&
        emptyValues.Count == 0u;
}

public static bool HasNullableIntSequence(IEnumerable<int?> values,
    int first, int third) {
    uint index = 0u;
    foreach (int? value in values) {
        if (index == 0u && (value == null || (value ?? 0) != first))
            return false;
        if (index == 1u && value != null) return false;
        if (index == 2u && (value == null || (value ?? 0) != third))
            return false;
        if (index > 2u) return false;
        index += 1u;
    }
    return index == 3u;
}

