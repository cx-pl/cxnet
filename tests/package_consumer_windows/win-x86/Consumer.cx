import System.Net.Http;

namespace M26ConsumerX86;

public final class HttpConsumerX86 {
    public HttpClient CreateClient() {
        return new HttpClient();
    }

    public HttpClient CreateClient(string caCertificateFile) {
        CurlHttpMessageHandler handler = new CurlHttpMessageHandler();
        handler.CaCertificateFile = caCertificateFile;
        handler.AllowUnknownCertificateRevocation = true;
        return new HttpClient(handler);
    }
}
