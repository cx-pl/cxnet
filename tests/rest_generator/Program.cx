public bool HasRestItemStackMap(
    const Dictionary<string, const Stack<RestItem>> values,
    string valueKey, string firstName, int firstQuantity,
    string lastName, int lastQuantity, string emptyKey) {
    const Stack<RestItem> items = values.GetValueOrDefault(valueKey);
    const Stack<RestItem> empty = values.GetValueOrDefault(emptyKey);
    Stack<RestItem> itemValues = items ?? new Stack<RestItem>();
    Stack<RestItem> emptyValues = empty ?? new Stack<RestItem>();
    if (values.Count != 2u || items == null || empty == null ||
        emptyValues.Count != 0u) return false;
    uint index = 0u;
    foreach (RestItem item in itemValues) {
        if (index == 0u && (item.Name != firstName ||
                item.Quantity != firstQuantity)) return false;
        if (index == 1u && (item.Name != lastName ||
                item.Quantity != lastQuantity)) return false;
        if (index > 1u) return false;
        index += 1u;
    }
    return index == 2u;
}

