public bool ConcurrentSerializerRegistrationLookup() {
    RestClient client = RestClient.For<ICustomSerializerApi>();
    AtomicInt lookupStarted = new AtomicInt(0);
    AtomicInt getterEntered = new AtomicInt(0);
    AtomicInt lookupResult = new AtomicInt(-1);
    AtomicInt registrationFinished = new AtomicInt(0);
    BlockingSerializerRegistration registration =
        new BlockingSerializerRegistration(lookupStarted, getterEntered);
    Thread registering = Thread.Start(() => {
        client.RegisterSerializer(registration);
        registrationFinished.Exchange(1);
    });
    while (getterEntered.Value == 0) Thread.Yield();
    Thread lookup = Thread.Start(() => {
        lookupStarted.Exchange(1);
        lookupResult.Exchange(
            client.HasSerializer(typeof(CustomRestItem)) ? 1 : 0);
    });
    registering.Join();
    lookup.Join();
    bool passed = registrationFinished.Value == 1 && lookupResult.Value == 1 &&
        client.HasSerializer(typeof(CustomRestItem));
    client.Dispose();
    return passed;
}

public bool ConcurrentRestResponseReadDispose() {
    RestResponse<string> response = new RestResponse<string>("race-value");
    response.SetResponse(new HttpResponseMessage(HttpStatusCode.OK));
    response.SetHasValue(true);
    response.SetErrorContent("race-error");
    AtomicInt start = new AtomicInt(0);
    AtomicInt readStarted = new AtomicInt(0);
    AtomicInt setterStarted = new AtomicInt(0);
    AtomicInt failures = new AtomicInt(0);
    Thread reader = Thread.Start(() => {
        while (start.Value == 0) Thread.Yield();
        for (uint index = 0u; index < 100000u; index += 1u) {
            try {
                bool hasValue = response.HasValue;
                string errorContent = response.ErrorContent;
                string value = response.GetValue();
                if (!hasValue || errorContent != "race-error" ||
                    value != "race-value") {
                    failures.Exchange(1);
                    return;
                }
                if (index == 0u) readStarted.Exchange(1);
            } catch (ObjectDisposedException) {
                return;
            } catch (Exception) {
                failures.Exchange(2);
                return;
            }
        }
    });
    Thread setter = Thread.Start(() => {
        while (start.Value == 0) Thread.Yield();
        setterStarted.Exchange(1);
        for (uint index = 0u; index < 100000u; index += 1u) {
            try {
                response.SetHasValue(true);
                response.SetErrorContent("race-error");
            } catch (ObjectDisposedException) {
                return;
            } catch (Exception) {
                failures.Exchange(3);
                return;
            }
        }
    });
    Thread disposer = Thread.Start(() => {
        while (start.Value == 0) Thread.Yield();
        while (readStarted.Value == 0 || setterStarted.Value == 0)
            Thread.Yield();
        response.Dispose();
        response.Dispose();
    });
    start.Exchange(1);
    reader.Join();
    setter.Join();
    disposer.Join();
    if (failures.Value != 0) return false;
    try {
        if (response.HasValue) return false;
        return false;
    } catch (ObjectDisposedException) {
        return true;
    }
}

