public bool IsInjectedRegistrationFailure(Task<string> pending) {
    if (!pending.IsCompleted || !pending.IsFaulted) return false;
    try {
        pending.GetResult();
    } catch (InvalidOperationException) {
        return true;
    }
    return false;
}

public bool IsInjectedRegistrationFailure(Task<RestItem> pending) {
    if (!pending.IsCompleted || !pending.IsFaulted) return false;
    try {
        pending.GetResult();
    } catch (InvalidOperationException) {
        return true;
    }
    return false;
}

public int RunGeneratedContinuationRegistrationFailure() {
    NativeTestHooks.FailContinuationRegistrationAfter(1u);
    RestClient scalarClient = RestClient.For<ITextApi>();
    scalarClient.BaseAddress = new Uri("https://example.test/");
    ITextApi scalarApi = scalarClient.GetContract<ITextApi>();
    Task<string> scalarPending = scalarApi.GetText(CancellationToken.None);
    if (!IsInjectedRegistrationFailure(scalarPending)) {
        scalarClient.Dispose();
        return 1;
    }
    scalarClient.Dispose();

    NativeTestHooks.FailContinuationRegistrationAfter(1u);
    RestClient dtoClient = RestClient.For<IJsonApi>();
    dtoClient.BaseAddress = new Uri("https://example.test/");
    IJsonApi dtoApi = dtoClient.GetContract<IJsonApi>();
    Task<RestItem> dtoPending = dtoApi.Get();
    if (!IsInjectedRegistrationFailure(dtoPending)) {
        dtoClient.Dispose();
        return 2;
    }
    dtoClient.Dispose();
    return 0;
}

public int RunMultipartSetupFailure() {
    RestRecordingHandler handler = new RestRecordingHandler();
    HttpClient http = new HttpClient(handler, false);
    RestClient client = RestClient.For<ISetupFailureApi>(http, false);
    client.BaseAddress = new Uri("https://example.test/");
    ISetupFailureApi api = client.GetContract<ISetupFailureApi>();
    StringContent part = new StringContent("multipart part");
    bool invalidHeaderRejected = false;
    try {
        api.SendMultipartWithInvalidHeader(part, "invalid\r\nvalue");
    } catch (ArgumentException) {
        invalidHeaderRejected = true;
    }
    bool partDisposed = ContentWasDisposed(part);
    client.Dispose();
    http.Dispose();
    if (!invalidHeaderRejected || !partDisposed) return 1;
    return 0;
}

