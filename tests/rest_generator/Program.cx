public final class RestRecordingHandler : HttpMessageHandler {
    public string LastMethod;
    public HttpStatusCode NextStatusCode;
    public string NextBody;
    public string NextResponseContentType;
    public string NextResponseHeader;
    public string LastUri;
    public string LastTraceHeader;
    public string LastHeaderTags;
    public string LastNullableNumericAmounts;
    public string LastNullableNumericFlags;
    public string LastOptionalHeader;
    public string LastOptionalUuidHeader;
    public string LastAuthorization;
    public string LastApiHeader;
    public string LastOverrideHeader;
    public string LastParentHeader;
    public string LastChildHeader;
    public string LastContentType;
    public string LastBody;
    public byte[] LastBodyBytes;
    public HttpContent LastContent;
    public HttpContent LastResponseContent;

    public constructor() {
        NextStatusCode = HttpStatusCode.OK;
        NextBody = null;
    }

    public override Task<HttpResponseMessage> SendAsync(
        HttpRequestMessage request, CancellationToken cancellationToken) {
        LastMethod = request.Method.Method;
        LastUri = request.RequestUri.ToString();
        LastTraceHeader = request.Headers.GetFirstValue("X-Trace");
        LastHeaderTags = "";
        LastNullableNumericAmounts = "";
        LastNullableNumericFlags = "";
        bool hasHeaderTag = false;
        bool hasNullableNumericAmount = false;
        bool hasNullableNumericFlag = false;
        for (uint headerIndex = 0u; headerIndex < request.Headers.Count;
            headerIndex += 1u) {
            HttpHeader header = request.Headers.Get(headerIndex);
            if (header.Name == "X-Tag") {
                if (hasHeaderTag) LastHeaderTags = LastHeaderTags + "|";
                LastHeaderTags = LastHeaderTags + header.Value;
                hasHeaderTag = true;
            }
            if (header.Name == "X-Numeric-Amount-List" ||
                header.Name == "X-Numeric-Amount-Array" ||
                header.Name == "X-Numeric-Amount-Linked" ||
                header.Name == "X-Numeric-Amount-Queue" ||
                header.Name == "X-Numeric-Amount-Stack" ||
                header.Name == "X-Numeric-Amount-Enumerable" ||
                header.Name == "X-Numeric-Amount-Collection") {
                if (hasNullableNumericAmount)
                    LastNullableNumericAmounts = LastNullableNumericAmounts + "|";
                LastNullableNumericAmounts = LastNullableNumericAmounts + header.Value;
                hasNullableNumericAmount = true;
            }
            if (header.Name == "X-Numeric-Flag") {
                if (hasNullableNumericFlag)
                    LastNullableNumericFlags = LastNullableNumericFlags + "|";
                LastNullableNumericFlags = LastNullableNumericFlags + header.Value;
                hasNullableNumericFlag = true;
            }
        }
        LastOptionalHeader = request.Headers.GetFirstValue("X-Optional");
        LastOptionalUuidHeader =
            request.Headers.GetFirstValue("X-Wire-Optional-Uuid");
        LastAuthorization = request.Headers.GetFirstValue("Authorization");
        LastApiHeader = request.Headers.GetFirstValue("X-Api");
        LastOverrideHeader = request.Headers.GetFirstValue("X-Override");
        LastParentHeader = request.Headers.GetFirstValue("X-Parent");
        LastChildHeader = request.Headers.GetFirstValue("X-Child");
        LastContentType = request.Content == null
            ? null : request.Content.Headers.GetFirstValue("Content-Type");
        LastBody = request.Content == null ||
            LastUri == "https://example.test/wire/binary-body" ||
            LastUri == "https://example.test/wire/optional-binary-body"
            ? null : request.Content.ReadAsString();
        LastBodyBytes = request.Content == null
            ? null : request.Content.ReadAsByteArray();
        LastContent = request.Content;
        HttpResponseMessage response = new HttpResponseMessage(NextStatusCode);
        if (NextResponseHeader != null) {
            response.Headers.Add("X-Fixture", NextResponseHeader);
        }
        if (NextBody != null) {
            response.Content = new StringContent(NextBody);
            if (NextResponseContentType != null) {
                response.Content.Headers.Remove("Content-Type");
                response.Content.Headers.Add("Content-Type", NextResponseContentType);
            }
        }
        LastResponseContent = response.Content;
        return new Task<HttpResponseMessage>(response);
    }
}

public final class RestConcurrentHandler : HttpMessageHandler {
    public override Task<HttpResponseMessage> SendAsync(
        HttpRequestMessage request, CancellationToken cancellationToken) {
        TaskCompletionSource<HttpResponseMessage> completion =
            new TaskCompletionSource<HttpResponseMessage>();
        HttpResponseMessage response = new HttpResponseMessage(HttpStatusCode.OK);
        response.Content = new StringContent(request.RequestUri.ToString());
        TaskScheduler.Post(() => completion.SetResult(response));
        return completion.Task;
    }
}

public final class CustomRestItemSerializer : IRestSerializer<CustomRestItem> {
    public string ContentType { const get => "application/x-cx-custom"; }

    public string Serialize(CustomRestItem value, object options) {
        StringBuilder result = new StringBuilder();
        result.Append((string)options);
        result.Append("|");
        result.Append(value.Name);
        result.Append("|");
        result.Append(value.Quantity);
        return result.ToString();
    }

    public CustomRestItem Deserialize(string content, object options) {
        CustomRestItem value = new CustomRestItem();
        value.Name = (string)options + "|" + content;
        value.Quantity = 73;
        return value;
    }
}

public final class RestItemOverrideSerializer : IRestSerializer<RestItem> {
    public string ContentType { const get => "application/x-cx-rest-item"; }

    public string Serialize(RestItem value, object options) {
        return value.Name + ":" + (string)options;
    }

    public RestItem Deserialize(string content, object options) {
        RestItem value = new RestItem();
        value.Name = content;
        value.Quantity = 99;
        return value;
    }
}

public final class BlockingSerializerRegistration : IRestSerializerRegistration {
    public AtomicInt LookupStarted;
    public AtomicInt GetterEntered;
    private string _contentType;

    public constructor(AtomicInt lookupStarted, AtomicInt getterEntered) {
        LookupStarted = lookupStarted;
        GetterEntered = getterEntered;
        _contentType = "application/x-cx-blocking";
    }

    public System.Reflection.TypeInfo ValueType {
        const get => typeof(CustomRestItem);
    }

    public string ContentType {
        const get {
            GetterEntered.Exchange(1);
            while (LookupStarted.Value == 0) Thread.Yield();
            Thread.Sleep(20);
            return _contentType;
        }
    }

    public string Serialize(object value, object options) { return "unused"; }
    public object Deserialize(string content, object options) {
        return new CustomRestItem();
    }
}

public bool CompleteResponse(Task<HttpResponseMessage> pending) {
    uint steps = 0u;
    while (!pending.IsCompleted && steps < 100000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    if (!pending.IsCompleted) return false;
    pending.GetResult().Dispose();
    uint drainSteps = 0u;
    while (TaskScheduler.RunOne() && drainSteps < 100000u) drainSteps += 1u;
    return true;
}

public bool CompleteWireVerb(Task<HttpResponseMessage> pending,
    string expectedBody) {
    uint steps = 0u;
    while (!pending.IsCompleted && steps < 100000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    if (!pending.IsCompleted || pending.IsCanceled) return false;
    HttpResponseMessage response = pending.GetResult();
    bool passed = response.StatusCode == HttpStatusCode.OK &&
        response.Headers.GetFirstValue("X-CX-Wire") == "generated" &&
        response.Content.ReadAsString() == expectedBody;
    response.Dispose();
    uint drainSteps = 0u;
    while (TaskScheduler.RunOne() && drainSteps < 100000u) drainSteps += 1u;
    return passed;
}

public Task<HttpResponseMessage> SearchNullableNumericCollectionShapes(
    IWireApi api) {
    List<int?> listValues = new List<int?>();
    listValues.Add(7);
    listValues.Add(null);
    listValues.Add(-3);
    const List<int?> constListValues = listValues;
    Array<int?> arrayValues = new Array<int?>(3u);
    arrayValues.Set(0u, 7);
    arrayValues.Set(1u, null);
    arrayValues.Set(2u, -3);
    const Array<int?> constArrayValues = arrayValues;
    LinkedList<int?> linkedValues = new LinkedList<int?>();
    linkedValues.AddLast(7);
    linkedValues.AddLast(null);
    linkedValues.AddLast(-3);
    const LinkedList<int?> constLinkedValues = linkedValues;
    Queue<int?> queueValues = new Queue<int?>();
    queueValues.Enqueue(7);
    queueValues.Enqueue(null);
    queueValues.Enqueue(-3);
    const Queue<int?> constQueueValues = queueValues;
    Stack<int?> stackValues = new Stack<int?>();
    stackValues.Push(-3);
    stackValues.Push(null);
    stackValues.Push(7);
    const Stack<int?> constStackValues = stackValues;
    const IEnumerable<int?> enumerableValues = listValues;
    const ICollection<int?> collectionValues = listValues;
    Queue<bool?> queueFlags = new Queue<bool?>();
    queueFlags.Enqueue(true);
    queueFlags.Enqueue(null);
    queueFlags.Enqueue(false);
    const Queue<bool?> constQueueFlags = queueFlags;

    List<decimal?> listAmounts = new List<decimal?>();
    listAmounts.Add(0.125m);
    listAmounts.Add(null);
    listAmounts.Add(-2.5m);
    const List<decimal?> constListAmounts = listAmounts;
    Array<decimal?> arrayAmounts = new Array<decimal?>(3u);
    arrayAmounts.Set(0u, 0.125m);
    arrayAmounts.Set(1u, null);
    arrayAmounts.Set(2u, -2.5m);
    const Array<decimal?> constArrayAmounts = arrayAmounts;
    LinkedList<decimal?> linkedAmounts = new LinkedList<decimal?>();
    linkedAmounts.AddLast(0.125m);
    linkedAmounts.AddLast(null);
    linkedAmounts.AddLast(-2.5m);
    const LinkedList<decimal?> constLinkedAmounts = linkedAmounts;
    Queue<decimal?> queueAmounts = new Queue<decimal?>();
    queueAmounts.Enqueue(0.125m);
    queueAmounts.Enqueue(null);
    queueAmounts.Enqueue(-2.5m);
    const Queue<decimal?> constQueueAmounts = queueAmounts;
    Stack<decimal?> stackAmounts = new Stack<decimal?>();
    stackAmounts.Push(-2.5m);
    stackAmounts.Push(null);
    stackAmounts.Push(0.125m);
    const Stack<decimal?> constStackAmounts = stackAmounts;
    const IEnumerable<decimal?> enumerableAmounts = listAmounts;
    const ICollection<decimal?> collectionAmounts = listAmounts;
    Stack<bool?> stackFlags = new Stack<bool?>();
    stackFlags.Push(false);
    stackFlags.Push(null);
    stackFlags.Push(true);
    const Stack<bool?> constStackFlags = stackFlags;

    return api.SearchNullableNumericCollections(
        constListValues, constArrayValues, constLinkedValues,
        constQueueValues, constStackValues, enumerableValues,
        collectionValues, constQueueFlags, constListAmounts, constArrayAmounts,
        constLinkedAmounts, constQueueAmounts, constStackAmounts,
        enumerableAmounts, collectionAmounts, constStackFlags);
}

public bool CompleteVoid(Task pending) {
    uint steps = 0u;
    while (!pending.IsCompleted && steps < 100000u) {
        if (!TaskScheduler.RunOne()) break;
        steps += 1u;
    }
    if (!pending.IsCompleted) return false;
    pending.GetResult();
    uint drainSteps = 0u;
    while (TaskScheduler.RunOne() && drainSteps < 100000u) drainSteps += 1u;
    return true;
}

