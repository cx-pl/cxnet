public bool HttpClientRejectsOpaqueUris() {
    HttpClient client = new HttpClient();
    Uri opaque = new Uri("mailto:user@example.test");
    HttpRequestMessage request = new HttpRequestMessage(
        HttpMethod.Get, new Uri("http:opaque"));
    bool rejectedBase = false;
    bool rejectedRequest = false;
    bool rejectedAuthorityAccess = false;
    bool rejectedRelativeResolution = false;
    bool authorityAccessReturned = false;
    bool relativeResolutionReturned = false;
    try {
        client.BaseAddress = new Uri("http:opaque");
    } catch (ArgumentException) {
        rejectedBase = true;
    }
    try {
        client.SendAsync(request);
    } catch (ArgumentException) {
        rejectedRequest = true;
    }
    try {
        string host = opaque.Host;
        authorityAccessReturned = host.Length == 0u;
    } catch (InvalidOperationException) {
        rejectedAuthorityAccess = true;
    }
    try {
        Uri invalidRelative = new Uri(opaque, "child");
        relativeResolutionReturned = invalidRelative.IsAbsoluteUri;
    } catch (ArgumentException) {
        rejectedRelativeResolution = true;
    }
    request.Dispose();
    client.Dispose();
    return rejectedBase && rejectedRequest && rejectedAuthorityAccess &&
        rejectedRelativeResolution && !authorityAccessReturned &&
        !relativeResolutionReturned;
}

