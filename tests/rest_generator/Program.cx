public bool HasNullableRestDtoMap(
    const Dictionary<string, RestItem?> values, string presentKey,
    string missingKey, string expectedName, int expectedQuantity) {
    if (values.Count != 2u) return false;
    RestItem? present = values.GetValueOrDefault(presentKey);
    RestItem item = present ?? new RestItem();
    if (present == null ||
        values.GetValueOrDefault(missingKey) != null ||
        item.Name != expectedName || item.Quantity != expectedQuantity)
        return false;
    return true;
}

public bool HasWireRestItems(IEnumerable<RestItem> items,
    string firstName, int firstQuantity, string secondName,
    int secondQuantity) {
    uint index = 0u;
    foreach (RestItem item in items) {
        if (index == 0u && (item.Name != firstName ||
                item.Quantity != firstQuantity)) return false;
        if (index == 1u && (item.Name != secondName ||
                item.Quantity != secondQuantity)) return false;
        if (index > 1u) return false;
        index += 1u;
    }
    return index == 2u;
}

public bool HasNullableWireRestItems(IEnumerable<RestItem?> items) {
    uint index = 0u;
    foreach (RestItem? nullableItem in items) {
        RestItem item = nullableItem ?? new RestItem();
        if (index == 0u) {
            if (nullableItem == null ||
                item.Name != "wire-nullable-first" ||
                item.Quantity != 31) return false;
        } else if (index == 1u) {
            if (nullableItem != null) return false;
        } else if (index == 2u) {
            if (nullableItem == null ||
                item.Name != "wire-nullable-last" ||
                item.Quantity != 33) return false;
        } else {
            return false;
        }
        index += 1u;
    }
    return index == 3u;
}

