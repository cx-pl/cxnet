public bool HasWireIntListMap(
    const Dictionary<string, const List<int>> values,
    string firstKey, int first, int second, int third,
    string secondKey, int fourth, int fifth) {
    if (values.Count != 2u) return false;
    const List<int> firstValues = values.GetValueOrDefault(firstKey);
    const List<int> secondValues = values.GetValueOrDefault(secondKey);
    if (firstValues == null || secondValues == null ||
        firstValues.Count != 3u || secondValues.Count != 2u) return false;
    return firstValues.Get(0u) == first &&
        firstValues.Get(1u) == second &&
        firstValues.Get(2u) == third &&
        secondValues.Get(0u) == fourth &&
        secondValues.Get(1u) == fifth;
}

public bool HasNullableWireIntListMap(
    const Dictionary<string, List<int?>?> values) {
    if (values.Count != 3u) return false;
    const List<int?>? items = values.GetValueOrDefault("items");
    const List<int?>? empty = values.GetValueOrDefault("empty");
    const List<int?>? missing = values.GetValueOrDefault("missing");
    List<int?> itemValues = items ?? new List<int?>();
    List<int?> emptyValues = empty ?? new List<int?>();
    int? firstValue = itemValues.Get(0u);
    int? middleValue = itemValues.Get(1u);
    int? lastValue = itemValues.Get(2u);
    return items != null && itemValues.Count == 3u &&
        (firstValue ?? 0) == 3 && middleValue == null &&
        (lastValue ?? 0) == -4 && empty != null &&
        emptyValues.Count == 0u && missing == null;
}

public int CheckNullableDtoListMap(
    Dictionary<string, List<RestItem?>?> values,
    string populatedKey, string emptyKey, string nullKey) {
    if (values.Count != 3u) return 1;
    const List<RestItem?>? populated = values.GetValueOrDefault(populatedKey);
    const List<RestItem?>? empty = values.GetValueOrDefault(emptyKey);
    const List<RestItem?>? missing = values.GetValueOrDefault(nullKey);
    if (populated == null) return 2;
    if (empty == null) return 3;
    if (missing != null) return 4;
    List<RestItem?> nonNullPopulated =
        populated ?? new List<RestItem?>();
    List<RestItem?> nonNullEmpty = empty ?? new List<RestItem?>();
    if (nonNullPopulated.Count != 3u) return 5;
    if (nonNullEmpty.Count != 0u) return 6;
    RestItem? first = nonNullPopulated.Get(0u);
    RestItem? middle = nonNullPopulated.Get(1u);
    RestItem? last = nonNullPopulated.Get(2u);
    RestItem firstValue = first ?? new RestItem();
    RestItem lastValue = last ?? new RestItem();
    if (first == null) return 7;
    if (firstValue.Name != "wire-nullable-first") return 8;
    if (firstValue.Quantity != 31) return 9;
    if (middle != null) return 10;
    if (last == null) return 11;
    if (lastValue.Name != "wire-nullable-last") return 12;
    if (lastValue.Quantity != 33) return 100 + lastValue.Quantity;
    return 0;
}

public bool HasWireStringValues(IEnumerable<string> values,
    string first, string second) {
    uint index = 0u;
    foreach (string value in values) {
        if (index == 0u && value != first) return false;
        if (index == 1u && value != second) return false;
        if (index > 1u) return false;
        index += 1u;
    }
    return index == 2u;
}

public bool HasSingleWireRestItem(IEnumerable<RestItem> items,
    string name, int quantity) {
    uint count = 0u;
    foreach (RestItem item in items) {
        if (item.Name != name || item.Quantity != quantity) return false;
        count += 1u;
    }
    return count == 1u;
}

