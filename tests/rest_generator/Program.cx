public bool HasNullableDecimalMap(const Dictionary<string, decimal?> values,
    string presentKey, string presentText, string missingKey,
    string negativeKey, string negativeText) {
    decimal? parsedPresent = Decimal.TryParse(presentText);
    decimal? parsedNegative = Decimal.TryParse(negativeText);
    if (parsedPresent == null || parsedNegative == null || values.Count != 3u)
        return false;
    decimal expectedPresent = parsedPresent ?? 0;
    decimal expectedNegative = parsedNegative ?? 0;
    decimal? present = values.GetValueOrDefault(presentKey);
    decimal? missing = values.GetValueOrDefault(missingKey);
    decimal? negative = values.GetValueOrDefault(negativeKey);
    return present != null && (present ?? 0) == expectedPresent &&
        missing == null && negative != null &&
        (negative ?? 0) == expectedNegative;
}

public bool HasNullableBoolMap(const Dictionary<string, bool?> values,
    string presentKey, bool presentValue, string missingKey,
    string falseKey, bool falseValue) {
    if (values.Count != 3u) return false;
    bool? present = values.GetValueOrDefault(presentKey);
    bool? missing = values.GetValueOrDefault(missingKey);
    bool? falseEntry = values.GetValueOrDefault(falseKey);
    return present != null && (present ?? false) == presentValue &&
        missing == null && falseEntry != null &&
        (falseEntry ?? true) == falseValue;
}

public bool HasNullableUuidMap(const Dictionary<string, Uuid?> values,
    string firstKey, Uuid firstValue, string missingKey,
    string secondKey, Uuid secondValue) {
    if (values.Count != 3u) return false;
    Uuid? first = values.GetValueOrDefault(firstKey);
    Uuid? missing = values.GetValueOrDefault(missingKey);
    Uuid? second = values.GetValueOrDefault(secondKey);
    return first != null && (first ?? firstValue).ToString() ==
        firstValue.ToString() &&
        missing == null && second != null &&
        (second ?? secondValue).ToString() == secondValue.ToString();
}

