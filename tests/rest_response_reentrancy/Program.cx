import System;
import System.IO;
import System.Net.Http;
import System.Net.Http.Rest;
import System.Threading;

namespace RestResponseReentrancy;

public class ReentrantDisposeStream : Stream {
    private RestResponse<int> _response;
    public bool DisposeEntered;
    public bool DisposeReturned;
    public uint DisposeCount;

    public constructor(RestResponse<int> response) {
        _response = response;
    }

    public override bool CanRead { get { return true; } }
    public override bool CanWrite { get { return false; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        return 0;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() {
        DisposeCount += 1u;
        DisposeEntered = true;
        _response.Dispose();
        DisposeReturned = true;
    }
}

public class ThrowingDisposeStream : Stream {
    public uint DisposeCount;

    public override bool CanRead { get { return true; } }
    public override bool CanWrite { get { return false; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        return 0;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() {
        DisposeCount += 1u;
        throw new IOException("injected stream disposal failure");
    }
}

public class CountingDisposeStream : Stream {
    public uint DisposeCount;

    public override bool CanRead { get { return true; } }
    public override bool CanWrite { get { return false; } }
    public override void Flush() { }
    public override int Read(byte[] buffer, uint offset, uint count) {
        return 0;
    }
    public override void Write(byte[] buffer, uint offset, uint count) {
        throw new NotSupportedException();
    }
    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException();
    }
    public override void SetLength(long value) {
        throw new NotSupportedException();
    }
    public override void Dispose() { DisposeCount += 1u; }
}

public bool RaceResponseAttachmentWithDispose() {
    for (uint iteration = 0u; iteration < 20u; iteration += 1u) {
        RestResponse<int> wrapper = new RestResponse<int>((int)iteration);
        HttpResponseMessage response =
            new HttpResponseMessage(HttpStatusCode.OK);
        CountingDisposeStream stream = new CountingDisposeStream();
        response.Content = new StreamContent(stream);
        AtomicInt start = new AtomicInt(0);
        AtomicInt attachState = new AtomicInt(0);
        Thread attach = Thread.Start(() => {
            while (start.Value == 0) Thread.Yield();
            try {
                wrapper.SetResponse(response);
                attachState.Exchange(1);
            } catch (ObjectDisposedException) {
                attachState.Exchange(2);
            } catch (Exception) {
                attachState.Exchange(3);
            }
        });
        Thread dispose = Thread.Start(() => {
            while (start.Value == 0) Thread.Yield();
            wrapper.Dispose();
        });
        start.Exchange(1);
        attach.Join();
        dispose.Join();
        if (attachState.Value == 1) {
            if (stream.DisposeCount != 1u) return false;
        } else if (attachState.Value == 2) {
            if (stream.DisposeCount != 0u) return false;
            response.Dispose();
            if (stream.DisposeCount != 1u) return false;
        } else {
            return false;
        }
    }
    return true;
}

public int Main(string[] args) {
    if (!RaceResponseAttachmentWithDispose()) return 7;
    RestResponse<int> responseWrapper = new RestResponse<int>(7);
    HttpResponseMessage response = new HttpResponseMessage(HttpStatusCode.OK);
    ReentrantDisposeStream stream = new ReentrantDisposeStream(responseWrapper);
    response.Content = new StreamContent(stream);
    responseWrapper.SetResponse(response);

    responseWrapper.Dispose();
    if (!stream.DisposeEntered || !stream.DisposeReturned ||
        stream.DisposeCount != 1u) return 1;

    bool disposedReadRejected = false;
    try {
        responseWrapper.StatusCode;
    } catch (ObjectDisposedException) {
        disposedReadRejected = true;
    }
    if (!disposedReadRejected) return 2;

    RestResponse<int> throwingWrapper = new RestResponse<int>(9);
    HttpResponseMessage throwingResponse =
        new HttpResponseMessage(HttpStatusCode.OK);
    ThrowingDisposeStream throwingStream = new ThrowingDisposeStream();
    throwingResponse.Content = new StreamContent(throwingStream);
    throwingWrapper.SetResponse(throwingResponse);
    bool cleanupFailurePropagated = false;
    try {
        throwingWrapper.Dispose();
    } catch (IOException) {
        cleanupFailurePropagated = true;
    }
    if (!cleanupFailurePropagated || throwingStream.DisposeCount != 1u)
        return 3;
    try {
        throwingWrapper.Dispose();
    } catch (Exception) {
        return 4;
    }
    if (throwingStream.DisposeCount != 1u) return 5;
    bool throwingWrapperRemainsDisposed = false;
    try {
        throwingWrapper.StatusCode;
    } catch (ObjectDisposedException) {
        throwingWrapperRemainsDisposed = true;
    }
    if (!throwingWrapperRemainsDisposed) return 6;
    return 0;
}
