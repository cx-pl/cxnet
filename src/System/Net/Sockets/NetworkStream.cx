import System;
import System.IO;
import System.Net.Sockets;
import System.Threading;
import System.Threading.Tasks;

namespace System.Net.Sockets;

public final class NetworkStream : Stream {
    private Socket _socket;
    private bool _ownsSocket;
    private bool _disposed;
    private Mutex _stateMutex;

    public constructor(Socket socket) : this(socket, false) { }

    public constructor(Socket socket, bool ownsSocket) {
        if (socket == null) throw new ArgumentNullException("socket");
        if (!socket.Connected) {
            throw new ArgumentException("The socket must be connected.", "socket");
        }
        _socket = socket;
        _ownsSocket = ownsSocket;
        _disposed = false;
        _stateMutex = new Mutex();
    }

    public override bool CanRead { get { return CanTransfer; } }
    public override bool CanWrite { get { return CanTransfer; } }

    private bool CanTransfer {
        get {
            Socket socket = null;
            _stateMutex.Lock();
            try {
                if (!_disposed) socket = _socket;
            } finally {
                _stateMutex.Unlock();
            }
            return socket != null && socket.Connected;
        }
    }

    public override void Flush() {
        GetOpenSocket();
    }

    public override int Read(byte[] buffer, uint offset, uint count) {
        Socket socket = GetOpenSocket();
        ValidateBuffer(buffer, offset, count);
        return socket.Receive(buffer, offset, count);
    }

    public override Task<uint> ReadAsync(
        byte[] buffer, uint offset, uint count,
        CancellationToken cancellationToken) {
        try {
            Socket socket = GetOpenSocket();
            ValidateBuffer(buffer, offset, count);
            return socket.ReadAsync(buffer, offset, count, cancellationToken);
        } catch (OperationCanceledException) {
            return CreateCanceledReadTask();
        } catch (Exception exception) {
            return CreateFaultedReadTask(exception);
        }
    }

    public override void Write(byte[] buffer, uint offset, uint count) {
        Socket socket = GetOpenSocket();
        ValidateBuffer(buffer, offset, count);
        uint sent = 0u;
        while (sent < count) {
            int transferred = socket.Send(buffer, offset + sent, count - sent);
            if (transferred <= 0) {
                throw new IOException("The socket closed before the full buffer was sent.");
            }
            sent += (uint)transferred;
        }
    }

    public override Task WriteAsync(
        byte[] buffer, uint offset, uint count,
        CancellationToken cancellationToken) {
        try {
            Socket socket = GetOpenSocket();
            ValidateBuffer(buffer, offset, count);
            cancellationToken.ThrowIfCancellationRequested();
            return NetworkStreamWriteOperation.Start(
                socket, buffer, offset, count, cancellationToken);
        } catch (OperationCanceledException) {
            return NetworkStreamWriteOperation.CreateCanceledTask();
        } catch (Exception exception) {
            return NetworkStreamWriteOperation.CreateFaultedTask(exception);
        }
    }

    public override long Seek(long offset, SeekOrigin origin) {
        throw new NotSupportedException("A network stream cannot seek.");
    }

    public override void SetLength(long value) {
        throw new NotSupportedException("A network stream has no fixed length.");
    }

    public override void Dispose() {
        Socket socket = null;
        bool ownsSocket = false;
        _stateMutex.Lock();
        try {
            if (_disposed) return;
            _disposed = true;
            socket = _socket;
            _socket = null;
            ownsSocket = _ownsSocket;
        } finally {
            _stateMutex.Unlock();
        }
        if (ownsSocket && socket != null) socket.Dispose();
    }

    private Socket GetOpenSocket() {
        Socket socket = null;
        _stateMutex.Lock();
        try {
            if (_disposed) throw new ObjectDisposedException("NetworkStream");
            socket = _socket;
        } finally {
            _stateMutex.Unlock();
        }
        if (socket == null || !socket.Connected) {
            throw new IOException("The socket is no longer connected.");
        }
        return socket;
    }

    private static void ValidateBuffer(byte[] buffer, uint offset, uint count) {
        if (buffer == null) throw new ArgumentNullException("buffer");
        if (offset > buffer.Length || count > buffer.Length - offset) {
            throw new ArgumentOutOfRangeException("offset");
        }
    }

    private static Task<uint> CreateCanceledReadTask() {
        TaskCompletionSource<uint> completion = new TaskCompletionSource<uint>();
        completion.SetCanceled();
        return completion.Task;
    }

    private static Task<uint> CreateFaultedReadTask(Exception exception) {
        TaskCompletionSource<uint> completion = new TaskCompletionSource<uint>();
        completion.SetException(exception);
        return completion.Task;
    }
}

internal final class NetworkStreamWriteOperation {
    private Socket _socket;
    private byte[] _buffer;
    private uint _offset;
    private uint _count;
    private uint _sent;
    private CancellationToken _cancellationToken;
    private Task _completion;

    private constructor(Socket socket, byte[] buffer, uint offset, uint count,
        CancellationToken cancellationToken) {
        _socket = socket;
        _buffer = buffer;
        _offset = offset;
        _count = count;
        _sent = 0u;
        _cancellationToken = cancellationToken;
        _completion = new TaskCompletionSource().Task;
    }

    public static Task Start(Socket socket, byte[] buffer, uint offset,
        uint count, CancellationToken cancellationToken) {
        NetworkStreamWriteOperation operation = new NetworkStreamWriteOperation(
            socket, buffer, offset, count, cancellationToken);
        if (count == 0u) {
            operation._completion.SetResult();
            operation.Finish();
        } else {
            operation.SendNext();
        }
        return operation._completion;
    }

    public static Task CreateCanceledTask() {
        Task completion = new TaskCompletionSource().Task;
        completion.SetCanceled();
        return completion;
    }

    public static Task CreateFaultedTask(Exception exception) {
        Task completion = new TaskCompletionSource().Task;
        completion.SetFault(exception);
        return completion;
    }

    private void SendNext() {
        if (_completion.IsCompleted) return;
        Task<uint> pending = null;
        uint requestedCount = _count - _sent;
        try {
            _cancellationToken.ThrowIfCancellationRequested();
            pending = _socket.WriteAsync(_buffer, _offset + _sent,
                requestedCount, _cancellationToken);
            if (pending == null) {
                throw new InvalidOperationException("The socket returned no write task.");
            }
        } catch (OperationCanceledException) {
            _completion.SetCanceled();
            Finish();
            return;
        } catch (Exception exception) {
            _completion.SetFault(exception);
            Finish();
            return;
        }
        NetworkStreamWriteOperation operation = this;
        try {
            pending.OnCompleted(() => operation.CompleteWrite(
                pending, requestedCount));
        } catch (OperationCanceledException) {
            _completion.SetCanceled();
            Finish();
        } catch (Exception exception) {
            _completion.SetFault(exception);
            Finish();
        }
    }

    private void CompleteWrite(Task<uint> pending, uint requestedCount) {
        if (_completion.IsCompleted) return;
        uint transferred = 0u;
        try {
            transferred = pending.GetResult();
        } catch (OperationCanceledException) {
            _completion.SetCanceled();
            Finish();
            return;
        } catch (Exception exception) {
            _completion.SetFault(exception);
            Finish();
            return;
        }
        if (transferred > requestedCount) {
            _completion.SetFault(new InvalidOperationException(
                "The socket reported more bytes sent than requested."));
            Finish();
            return;
        }
        if (transferred == 0u) {
            _completion.SetFault(new IOException(
                "The socket closed before the full buffer was sent."));
            Finish();
            return;
        }
        _sent += transferred;
        if (_sent == _count) {
            _completion.SetResult();
            Finish();
            return;
        }
        SendNext();
    }

    private void Finish() {
        _socket = null;
        _buffer = null;
    }
}
