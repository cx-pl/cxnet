    private static void CompleteStringRead(
        Task<HttpResponseMessage> pending, Task<string> completion) {
        HttpResponseMessage response = null;
        try {
            response = pending.GetResult();
            response.EnsureSuccessStatusCode();
            completion.SetResult(response.Content == null
                ? "" : response.Content.ReadAsString());
        } catch (OperationCanceledException) {
            completion.SetCanceled();
        } catch (Exception exception) {
            completion.SetFault(exception);
        } finally {
            if (response != null) response.Dispose();
        }
    }

    public Task<string> GetStringAsync(Uri requestUri, CancellationToken cancellationToken) {
        Task<string> completion = new Task<string>();
        HttpRequestMessage request = new HttpRequestMessage(
            HttpMethod.Get, requestUri);
        try {
            SendAndDisposeAsync(request, cancellationToken, false,
                (Task<HttpResponseMessage> pending) =>
                    CompleteStringRead(pending, completion));
        } catch (Exception exception) {
            completion.SetFault(exception);
        }
        return completion;
    }

    public Task<string> GetStringAsync(Uri requestUri) {
        return GetStringAsync(requestUri, CancellationToken.None);
    }

    public Task<string> GetStringAsync(string requestUri,
        CancellationToken cancellationToken) {
        return GetStringAsync(new Uri(requestUri), cancellationToken);
    }

    public Task<string> GetStringAsync(string requestUri) {
        return GetStringAsync(new Uri(requestUri), CancellationToken.None);
    }

    private static void CompleteByteArrayRead(
        Task<HttpResponseMessage> pending, Task<byte[]> completion) {
        HttpResponseMessage response = null;
        try {
            response = pending.GetResult();
            response.EnsureSuccessStatusCode();
            completion.SetResult(response.Content == null
                ? new byte[0u] : response.Content.ReadAsByteArray());
        } catch (OperationCanceledException) {
            completion.SetCanceled();
        } catch (Exception exception) {
            completion.SetFault(exception);
        } finally {
            if (response != null) response.Dispose();
        }
    }

    public Task<byte[]> GetByteArrayAsync(Uri requestUri, CancellationToken cancellationToken) {
        Task<byte[]> completion = new Task<byte[]>();
        HttpRequestMessage request = new HttpRequestMessage(
            HttpMethod.Get, requestUri);
        try {
            SendAndDisposeAsync(request, cancellationToken, false,
                (Task<HttpResponseMessage> pending) =>
                    CompleteByteArrayRead(pending, completion));
        } catch (Exception exception) {
            completion.SetFault(exception);
        }
        return completion;
    }

    public Task<byte[]> GetByteArrayAsync(Uri requestUri) {
        return GetByteArrayAsync(requestUri, CancellationToken.None);
    }

    public Task<byte[]> GetByteArrayAsync(string requestUri,
        CancellationToken cancellationToken) {
