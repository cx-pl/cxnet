    }

    private static void CompleteStreamRead(
        Task<HttpResponseMessage> pending, Task<Stream> completion) {
        HttpResponseMessage response = null;
        try {
            response = pending.GetResult();
            response.EnsureSuccessStatusCode();
            Stream contentStream = response.Content == null
                ? new MemoryStream(new byte[0u])
                : response.Content.ReadAsStream();
            completion.SetResult(new ResponseOwnedStream(contentStream, response));
            response = null;
        } catch (OperationCanceledException) {
            completion.SetCanceled();
        } catch (Exception exception) {
            completion.SetFault(exception);
        } finally {
            if (response != null) response.Dispose();
        }
    }

    public Task<Stream> GetStreamAsync(
        Uri requestUri, CancellationToken cancellationToken) {
        Task<Stream> completion = new Task<Stream>();
        HttpRequestMessage request = new HttpRequestMessage(
            HttpMethod.Get, requestUri);
        try {
            SendAndDisposeAsync(request, cancellationToken, true,
                (Task<HttpResponseMessage> pending) =>
                    CompleteStreamRead(pending, completion));
        } catch (Exception exception) {
            completion.SetFault(exception);
        }
        return completion;
    }

    public Task<Stream> GetStreamAsync(Uri requestUri) {
        return GetStreamAsync(requestUri, CancellationToken.None);
    }

    public Task<Stream> GetStreamAsync(string requestUri,
        CancellationToken cancellationToken) {
        return GetStreamAsync(new Uri(requestUri), cancellationToken);
    }

    public Task<Stream> GetStreamAsync(string requestUri) {
        return GetStreamAsync(new Uri(requestUri), CancellationToken.None);
    }

    public void Dispose() {
        bool shouldDispose = false;
        _stateMutex.Lock();
        try {
            if (!_disposed) {
                _disposed = true;
                shouldDispose = true;
            }
        } finally {
            _stateMutex.Unlock();
        }
        if (!shouldDispose) return;
        try {
            _disposeCancellationSource.Cancel();
        } catch (Exception exception) {
            // Cancellation visits every send callback before reporting failures.
            // Disposal is terminal even when a callback cannot post cleanup.
        } finally {
            if (_disposeHandler) _handler.Dispose();
        }
    }
}

internal final class HttpSendCancellation : IDisposable {
    private CancellationTokenSource _source;
    private AtomicInt _cancelStarted;
    private Mutex _stateMutex;
    private bool _disposed;
    private CancellationTokenRegistration _lifetimeRegistration;
    private CancellationTokenRegistration _callerRegistration;

    public CancellationToken Token { const get => _source.Token; }

    public constructor(CancellationToken lifetimeToken, CancellationToken callerToken) {
        _source = new CancellationTokenSource();
        _cancelStarted = new AtomicInt(0);
        _stateMutex = new Mutex();
        _disposed = false;
        HttpSendCancellation state = this;
        _lifetimeRegistration = CancellationTokenRegistration.None;
        _callerRegistration = CancellationTokenRegistration.None;
        try {
            _lifetimeRegistration = lifetimeToken.Register(() => state.Cancel());
            _callerRegistration = callerToken.Register(() => state.Cancel());
        } catch (Exception exception) {
            try {
                _callerRegistration.Dispose();
            } catch (Exception) { }
            try {
                _lifetimeRegistration.Dispose();
            } catch (Exception) { }
            throw exception;
        }
    }

    internal void Cancel() {
        if (_cancelStarted.CompareExchange(1, 0) == 0) _source.Cancel();
    }

    public void Dispose() {
        CancellationTokenRegistration lifetimeRegistration =
            CancellationTokenRegistration.None;
        CancellationTokenRegistration callerRegistration =
            CancellationTokenRegistration.None;
        _stateMutex.Lock();
        try {
            if (_disposed) return;
            _disposed = true;
            lifetimeRegistration = _lifetimeRegistration;
            callerRegistration = _callerRegistration;
            _lifetimeRegistration = CancellationTokenRegistration.None;
            _callerRegistration = CancellationTokenRegistration.None;
        } finally {
            _stateMutex.Unlock();
        }
        try {
            lifetimeRegistration.Dispose();
        } catch (Exception) { }
        try {
            callerRegistration.Dispose();
        } catch (Exception) { }
    }
}

internal final class ResponseOwnedStream : Stream {
    private Stream _inner;
    private HttpResponseMessage _response;
    private bool _disposed;
    private Mutex _stateMutex;

    public override bool CanRead {
        get {
            Stream inner = GetInnerIfOpen();
            return inner != null && inner.CanRead;
        }
    }
    public override bool CanWrite { get { return false; } }
    public override bool CanSeek {
        get {
            Stream inner = GetInnerIfOpen();
            return inner != null && inner.CanSeek;
        }
    }

    public constructor(Stream inner, HttpResponseMessage response) {
        if (inner == null) throw new ArgumentNullException("inner");
        if (response == null) throw new ArgumentNullException("response");
        _inner = inner;
        _response = response;
        _stateMutex = new Mutex();
    }

    public override void Flush() {
        GetOpenInner().Flush();
    }

    public override int Read(byte[] buffer, uint offset, uint count) {
        return GetOpenInner().Read(buffer, offset, count);
    }

    public override Task<uint> ReadAsync(byte[] buffer, uint offset, uint count,
        CancellationToken cancellationToken) {
        return GetOpenInner().ReadAsync(buffer, offset, count, cancellationToken);
    }

    public override void Write(byte[] buffer, uint offset, uint count) {
        GetOpenInner();
        throw new NotSupportedException();
    }

    public override long Seek(long offset, SeekOrigin origin) {
        return GetOpenInner().Seek(offset, origin);
    }

    public override void SetLength(long value) {
        GetOpenInner();
        throw new NotSupportedException();
    }

    private Stream GetOpenInner() {
        Stream inner;
        _stateMutex.Lock();
        try {
            if (_disposed) throw new ObjectDisposedException("ResponseOwnedStream");
            inner = _inner;
        } finally {
            _stateMutex.Unlock();
        }
        return inner;
    }

    private Stream GetInnerIfOpen() {
        Stream inner;
        _stateMutex.Lock();
        try {
            if (_disposed) return null;
            inner = _inner;
        } finally {
            _stateMutex.Unlock();
        }
        return inner;
    }

    public override void Dispose() {
        HttpResponseMessage response = null;
        _stateMutex.Lock();
        try {
            if (_disposed) return;
            _disposed = true;
            response = _response;
            _response = null;
            _inner = null;
        } finally {
            _stateMutex.Unlock();
        }
        if (response != null) response.Dispose();
    }
}
