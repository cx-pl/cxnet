import Cx.Compiler.Generators;
import System;
import System.Collections;

public final class CxnetRestGenerator : ICxGenerator {
    private ClosedGenericRequest[] _closedGenericRequests;
    private Dictionary<string, Dictionary<string, ClosedGenericRequest>> _closedGenericIndex;
    private Dictionary<string, List<uint>> _annotationIndices;
    private Dictionary<string, string> _declaringTypeIdentities;
    private string _projectName;

    public void Generate(GeneratorInputSnapshot snapshot,
        AdditionalText[] additionalFiles, GeneratorOutputContext output) {
        _closedGenericRequests = snapshot.ClosedGenericRequests;
        _projectName = snapshot.ProjectName;
        // The worker invokes Generate in an arena, while this generator owns
        // the indexes. Keep cached identities in the generator's durable lifetime.
        CxnetRestGenerator generator = this;
        Memory.WithDurable(() => {
            generator.IndexClosedGenericRequests();
            generator.IndexSnapshot(snapshot.Types, snapshot.Annotations);
        });
        TypeDescriptor[] types = snapshot.Types;
        AnnotationDescriptor[] annotations = snapshot.Annotations;
        ClosedGenericMethodRequest[] requests = snapshot.ClosedGenericMethodRequests;
        ValidateFactoryRequests(types, requests, output);
        for (uint typeIndex = 0u; typeIndex < types.Length; typeIndex += 1u) {
            TypeDescriptor type = types[typeIndex];
            if (type.Kind != GeneratorValueKind.Interface || type.Visibility != "Public") continue;
            if (!type.IsGenericDefinition) {
                if (!HasFactoryRequest(type, requests)) continue;
                GenerateContract(type, new string[0u], types, annotations, output);
                continue;
            }
            string[] genericParameters = type.GenericParameters;
            string[] seenClosedIdentities = new string[requests.Length];
            uint seenCount = 0u;
            for (uint requestIndex = 0u; requestIndex < requests.Length;
                requestIndex += 1u) {
                ClosedGenericMethodRequest request = requests[requestIndex];
                if (!IsRestClientForRequest(request) || request.TypeArguments.Length != 1u)
                    continue;
                string closedIdentity = request.TypeArguments[0];
                string[] typeArguments = GetClosedBaseTypeArguments(closedIdentity);
                if (typeArguments.Length != genericParameters.Length ||
                    NormalizeTypeIdentity(GetClosedGenericIdentity(type.Identity,
                        typeArguments)) != NormalizeTypeIdentity(closedIdentity)) continue;
                bool alreadyGenerated = false;
                for (uint seenIndex = 0u; seenIndex < seenCount; seenIndex += 1u)
                    if (NormalizeTypeIdentity(seenClosedIdentities[seenIndex]) ==
                        NormalizeTypeIdentity(closedIdentity))
                        alreadyGenerated = true;
                if (alreadyGenerated) continue;
                seenClosedIdentities[seenCount] = closedIdentity;
                seenCount += 1u;
                GenerateContract(type, typeArguments, types, annotations, output);
            }
        }
    }

    private void ValidateFactoryRequests(TypeDescriptor[] types,
        ClosedGenericMethodRequest[] requests, GeneratorOutputContext output) {
        for (uint requestIndex = 0u; requestIndex < requests.Length;
            requestIndex += 1u) {
            ClosedGenericMethodRequest request = requests[requestIndex];
            if (!IsRestClientForRequest(request)) continue;
            if (request.TypeArguments.Length != 1u) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST019",
                    "RestClient.For<T>() requires one closed interface contract type.",
                    DiagnosticSeverity.Error, request.Location));
                continue;
            }
            string requestedIdentity = request.TypeArguments[0];
            bool found = false;
            bool supported = false;
            SourceLocation diagnosticLocation = request.Location;
            for (uint typeIndex = 0u; typeIndex < types.Length; typeIndex += 1u) {
                TypeDescriptor type = types[typeIndex];
                bool matches = false;
                if (type.IsGenericDefinition) {
                    string[] arguments = GetClosedBaseTypeArguments(requestedIdentity);
                    if (arguments.Length == type.GenericParameters.Length &&
                        NormalizeTypeIdentity(GetClosedGenericIdentity(type.Identity,
                            arguments)) == NormalizeTypeIdentity(requestedIdentity))
                        matches = true;
                } else if (NormalizeTypeIdentity(type.Identity) ==
                    NormalizeTypeIdentity(requestedIdentity)) {
                    matches = true;
                }
                if (!matches) continue;
                found = true;
                diagnosticLocation = type.Location;
                if (type.Kind == GeneratorValueKind.Interface &&
                    type.Visibility == "Public")
                    supported = true;
            }
            if (!supported) {
                string message = found
                    ? "RestClient.For<T>() requires a public interface contract."
                    : "RestClient.For<T>() contract type '" + requestedIdentity +
                        "' is not available in the generator snapshot.";
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST019",
                    message, DiagnosticSeverity.Error, diagnosticLocation));
            }
        }
    }

    private void GenerateContract(TypeDescriptor type, string[] typeArguments,
        TypeDescriptor[] types, AnnotationDescriptor[] annotations,
        GeneratorOutputContext output) {
        MemberDescriptor[] members = CollectContractMembers(type,
            typeArguments, types, output);
        if (!HasAnnotatedMethod(members, annotations)) {
            output.ReportDiagnostic(new GeneratorDiagnostic("CXREST020",
                "A REST contract must declare or inherit at least one HTTP-annotated method.",
                DiagnosticSeverity.Error, type.Location));
            return;
        }
        if (HasSignatureConflict(members)) {
            output.ReportDiagnostic(new GeneratorDiagnostic("CXREST017",
                "Inherited REST methods cannot declare the same name and parameter types more than once.",
                DiagnosticSeverity.Error, type.Location));
            return;
        }
        EmitContract(type, typeArguments, members, types, annotations, output);
    }

    private bool HasFactoryRequest(TypeDescriptor type,
        ClosedGenericMethodRequest[] requests) {
        for (uint requestIndex = 0u; requestIndex < requests.Length; requestIndex += 1u) {
            ClosedGenericMethodRequest request = requests[requestIndex];
            if (request.TypeArguments.Length != 1u ||
                NormalizeTypeIdentity(request.TypeArguments[0]) !=
                    NormalizeTypeIdentity(type.Identity)) continue;
            if (IsRestClientForRequest(request)) return true;
        }
        return false;
    }

    private bool IsRestClientForRequest(ClosedGenericMethodRequest request) {
        string factoryPrefix = "cxnet.System.Net.Http.Rest.RestClient.For(";
        if (request.DefinitionIdentity.Length < factoryPrefix.Length) return false;
        for (uint index = 0u; index < factoryPrefix.Length; index += 1u)
            if (request.DefinitionIdentity.Item[index] != factoryPrefix.Item[index])
                return false;
        return true;
    }

    private MemberDescriptor[] CollectContractMembers(TypeDescriptor type,
        string[] typeArguments, TypeDescriptor[] types,
        GeneratorOutputContext output) {
        uint capacity = CountHierarchyMembers(type, types);
        MemberDescriptor[] collected = new MemberDescriptor[capacity];
        uint[] count = new uint[1u];
        AppendHierarchyMembers(type, typeArguments, types, collected, count, output);
        MemberDescriptor[] result = new MemberDescriptor[count[0]];
        for (uint index = 0u; index < count[0]; index += 1u)
            result[index] = collected[index];
        return result;
    }

    private uint CountHierarchyMembers(TypeDescriptor type, TypeDescriptor[] types) {
        uint count = (uint)type.Members.Length;
        string[] baseIdentities = type.BaseTypeIdentities;
        for (uint baseIndex = 0u; baseIndex < baseIdentities.Length; baseIndex += 1u) {
            TypeDescriptor baseType = FindBaseInterfaceType(baseIdentities[baseIndex], types);
            if (baseType != null) count += CountHierarchyMembers(baseType, types);
        }
        return count;
    }

    private void AppendHierarchyMembers(TypeDescriptor type, string[] typeArguments,
        TypeDescriptor[] types, MemberDescriptor[] destination, uint[] count,
        GeneratorOutputContext output) {
        MemberDescriptor[] ownMembers = type.Members;
        for (uint memberIndex = 0u; memberIndex < ownMembers.Length; memberIndex += 1u) {
            MemberDescriptor member = typeArguments.Length == 0u
                ? ownMembers[memberIndex]
                : CloseInterfaceMember(ownMembers[memberIndex], type, typeArguments);
            bool seen = false;
            for (uint existingIndex = 0u; existingIndex < count[0]; existingIndex += 1u) {
                if (AreEquivalentMemberDeclarations(destination[existingIndex], member)) {
                    seen = true;
                    break;
                }
            }
            if (!seen) {
                destination[count[0]] = member;
                count[0] += 1u;
            }
        }
        string[] baseIdentities = type.BaseTypeIdentities;
        for (uint baseIndex = 0u; baseIndex < baseIdentities.Length; baseIndex += 1u) {
            string baseIdentity = baseIdentities[baseIndex];
            TypeDescriptor baseType = FindBaseInterfaceType(baseIdentity, types);
            if (baseType == null || baseType.Kind != GeneratorValueKind.Interface) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST018",
                    "The inherited interface contract '" + baseIdentity +
                    "' is not available in the generator snapshot.",
                    DiagnosticSeverity.Error, type.Location));
                continue;
            }
            string[] baseArguments = GetClosedBaseTypeArguments(baseIdentity);
            if (baseType.IsGenericDefinition) {
                string[] genericParameters = baseType.GenericParameters;
                if (baseArguments.Length != genericParameters.Length) {
                    output.ReportDiagnostic(new GeneratorDiagnostic("CXREST018",
                        "The inherited generic interface '" + baseIdentity +
                        "' is not a closed construction.",
                        DiagnosticSeverity.Error, type.Location));
                    continue;
                }
                for (uint argumentIndex = 0u; argumentIndex < baseArguments.Length;
                    argumentIndex += 1u)
                    baseArguments[argumentIndex] = SubstituteTypeIdentity(
                        baseArguments[argumentIndex], type.GenericParameters, typeArguments);
            } else if (baseArguments.Length != 0u) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST018",
                    "The inherited interface '" + baseIdentity +
                    "' has generic arguments but no generic definition.",
                    DiagnosticSeverity.Error, type.Location));
                continue;
            }
            AppendHierarchyMembers(baseType, baseArguments, types,
                destination, count, output);
        }
    }

    private bool AreEquivalentMemberDeclarations(MemberDescriptor left,
        MemberDescriptor right) {
        if (left.Identity != right.Identity || left.TypeIdentity != right.TypeIdentity ||
            left.Parameters.Length != right.Parameters.Length) return false;
        ParameterDescriptor[] leftParameters = left.Parameters;
        ParameterDescriptor[] rightParameters = right.Parameters;
        for (uint index = 0u; index < leftParameters.Length; index += 1u)
            if (leftParameters[index].TypeIdentity != rightParameters[index].TypeIdentity)
                return false;
        return true;
    }

    private MemberDescriptor CloseInterfaceMember(MemberDescriptor member,
        TypeDescriptor type, string[] arguments) {
        string[] parameters = type.GenericParameters;
        string closedTypeIdentity = SubstituteTypeIdentity(member.TypeIdentity,
            parameters, arguments);
        ParameterDescriptor[] originalParameters = member.Parameters;
        ParameterDescriptor[] closedParameters =
            new ParameterDescriptor[originalParameters.Length];
        for (uint index = 0u; index < originalParameters.Length; index += 1u) {
            ParameterDescriptor parameter = originalParameters[index];
            string closedParameterType = SubstituteTypeIdentity(
                parameter.TypeIdentity, parameters, arguments);
            closedParameters[index] = new ParameterDescriptor(parameter.Name,
                closedParameterType,
                parameter.IsNullable || IsNullableTypeIdentity(closedParameterType),
                parameter.DefaultValue, parameter.Location);
        }
        return new MemberDescriptor(member.Identity, member.Name, closedTypeIdentity,
            member.Visibility, member.Kind, member.IsStatic, member.IsReadOnly,
            member.IsNullable || IsNullableTypeIdentity(closedTypeIdentity),
            closedParameters, member.ConstantValue, member.Location);
    }

    private string SubstituteTypeIdentity(string identity, string[] parameters,
        string[] arguments) {
        StringBuilder result = new StringBuilder();
        uint index = 0u;
        while (index < identity.Length) {
            bool substituted = false;
            if (identity.Item[index] == '!') {
                for (uint parameterIndex = 0u;
                    parameterIndex < parameters.Length && parameterIndex < arguments.Length;
                    parameterIndex += 1u) {
                    string parameter = parameters[parameterIndex];
                    uint end = index + 1u + parameter.Length;
                    if (end > identity.Length) continue;
                    bool matches = true;
                    for (uint offset = 0u; offset < parameter.Length; offset += 1u)
                        if (identity.Item[index + 1u + offset] != parameter.Item[offset])
                            matches = false;
                    if (!matches || (end < identity.Length &&
                        IsIdentifierCharacter(identity.Item[end]))) continue;
                    result.Append(arguments[parameterIndex]);
                    index = end;
                    substituted = true;
                    break;
                }
            }
            if (!substituted) {
                result.Append(identity.Item[index]);
                index += 1u;
            }
        }
        return result.ToString();
    }

    private bool IsIdentifierCharacter(char value) {
        return (value >= 'A' && value <= 'Z') ||
            (value >= 'a' && value <= 'z') ||
            (value >= '0' && value <= '9') || value == '_';
    }

    private bool IsNullableTypeIdentity(string identity) {
        return identity.Length > 0u && identity.Item[identity.Length - 1u] == '?';
    }

    private TypeDescriptor FindBaseInterfaceType(string baseIdentity,
        TypeDescriptor[] types) {
        string definitionName = GetClosedBaseTypeDefinition(baseIdentity);
        string normalizedDefinition = NormalizeTypeIdentity(definitionName);
        for (uint index = 0u; index < types.Length; index += 1u) {
            TypeDescriptor type = types[index];
            if (type.Kind != GeneratorValueKind.Interface) continue;
            if (NormalizeTypeIdentity(RemoveGenericArity(type.Identity)) ==
                normalizedDefinition) return type;
        }
        return null;
    }

    private string GetClosedBaseTypeDefinition(string identity) {
        StringBuilder result = new StringBuilder();
        for (uint index = 0u; index < identity.Length; index += 1u) {
            if (identity.Item[index] == '<') break;
            result.Append(identity.Item[index]);
        }
        return result.ToString();
    }

    private string RemoveGenericArity(string identity) {
        StringBuilder result = new StringBuilder();
        uint index = 0u;
        while (index < identity.Length) {
            char value = identity.Item[index];
            if (value == '`') {
                index += 1u;
                while (index < identity.Length && identity.Item[index] >= '0' &&
                    identity.Item[index] <= '9') index += 1u;
            } else {
                result.Append(value);
                index += 1u;
            }
        }
        return result.ToString();
    }

    private string[] GetClosedBaseTypeArguments(string identity) {
        uint openIndex = identity.Length;
        for (uint index = 0u; index < identity.Length; index += 1u)
            if (identity.Item[index] == '<') { openIndex = index; break; }
        if (openIndex == identity.Length) return new string[0u];
        uint count = 1u;
        uint depth = 0u;
        for (uint index = openIndex + 1u; index < identity.Length; index += 1u) {
            char value = identity.Item[index];
            if (value == '<') depth += 1u;
            else if (value == '>') {
                if (depth == 0u) break;
                depth -= 1u;
            } else if (value == ',' && depth == 0u) count += 1u;
        }
        string[] result = new string[count];
        uint resultIndex = 0u;
        depth = 0u;
        StringBuilder argument = new StringBuilder();
        for (uint index = openIndex + 1u; index < identity.Length; index += 1u) {
            char value = identity.Item[index];
            if (value == '<') {
                depth += 1u;
                argument.Append(value);
            } else if (value == '>') {
                if (depth == 0u) {
                    result[resultIndex] = argument.ToString();
                    break;
                }
                depth -= 1u;
                argument.Append(value);
            } else if (value == ',' && depth == 0u) {
                result[resultIndex] = argument.ToString();
                resultIndex += 1u;
                argument.Clear();
            } else {
                argument.Append(value);
            }
        }
        return result;
    }

    private TypeDescriptor FindType(string identity, TypeDescriptor[] types) {
        for (uint index = 0u; index < types.Length; index += 1u) {
            if (types[index].Identity == identity) return types[index];
        }
        return null;
    }

    private bool HasSignatureConflict(MemberDescriptor[] members) {
        for (uint leftIndex = 0u; leftIndex < members.Length; leftIndex += 1u) {
            MemberDescriptor left = members[leftIndex];
            if (left.Kind != GeneratorValueKind.Method || left.IsStatic) continue;
            for (uint rightIndex = leftIndex + 1u; rightIndex < members.Length;
                rightIndex += 1u) {
                MemberDescriptor right = members[rightIndex];
                if (right.Kind != GeneratorValueKind.Method || right.IsStatic ||
                    left.Name != right.Name || left.Parameters.Length != right.Parameters.Length)
                    continue;
                if (left.Identity == right.Identity) continue;
                ParameterDescriptor[] leftParameters = left.Parameters;
                ParameterDescriptor[] rightParameters = right.Parameters;
                bool sameSignature = true;
                for (uint parameterIndex = 0u; parameterIndex < leftParameters.Length;
                    parameterIndex += 1u) {
                    if (leftParameters[parameterIndex].TypeIdentity !=
                        rightParameters[parameterIndex].TypeIdentity) {
                        sameSignature = false;
                        break;
                    }
                }
                if (sameSignature) return true;
            }
        }
        return false;
    }

    private void EmitContract(TypeDescriptor type, string[] typeArguments,
        MemberDescriptor[] members, TypeDescriptor[] types,
        AnnotationDescriptor[] annotations, GeneratorOutputContext output) {
        string contractName = GetNonGenericTypeName(GetSimpleName(type.MetadataName));
        string contractTypeName = GetClosedInterfaceSourceTypeName(
            type, typeArguments, types);
        string clientName = contractName + GetClosedContractNameSuffix(typeArguments) +
            "RestClient";
        string registrationName = clientName + "Registration";
        StringBuilder source = new StringBuilder();
        source.Append("import System;\n" +
            "import System.Collections;\n" +
            "import System.IO;\n" +
            "import System.Net.Http;\n" +
            "import System.Net.Http.Rest;\n" +
            "import System.Threading.Tasks;\n" +
            "namespace " + type.NamespaceName + ";\n\n" +
            "public final class " + clientName + " : " + contractTypeName + " {\n" +
            "    private RestClient _client;\n" +
            "    public constructor(RestClient client) { _client = client; }\n");
        bool hasMethod = false;
        for (uint memberIndex = 0u; memberIndex < members.Length; memberIndex += 1u) {
            MemberDescriptor member = members[memberIndex];
            if (member.Kind == GeneratorValueKind.Property) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST003",
                    "REST interface properties are not supported.",
                    DiagnosticSeverity.Error, member.Location));
                continue;
            }
            if (member.Kind != GeneratorValueKind.Method || member.IsStatic) continue;
            int verbIndex = FindVerbIndex(member, annotations);
            if (verbIndex < 0) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST004",
                    "Every instance REST contract method must have one HTTP verb annotation.",
                    DiagnosticSeverity.Error, member.Location));
                continue;
            }
            if (CountVerbAnnotations(member, annotations) != 1u) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST004",
                    "Every instance REST contract method must have exactly one HTTP verb annotation.",
                    DiagnosticSeverity.Error, member.Location));
                continue;
            }
            string declaringTypeIdentity = GetDeclaringInterfaceIdentity(
                member, types, type.Identity);
            if (!HasValidStaticHeaders(declaringTypeIdentity, annotations) ||
                (declaringTypeIdentity != type.Identity &&
                    !HasValidStaticHeaders(type.Identity, annotations)) ||
                !HasValidStaticHeaders(member.Identity, annotations)) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST022",
                    "Header names must be HTTP tokens, static header values must not contain invalid control characters, and Content-Length or Transfer-Encoding cannot be set by a REST contract.",
                    DiagnosticSeverity.Error, member.Location));
                continue;
            }
            AnnotationDescriptor verb = annotations[(uint)verbIndex];
            hasMethod = true;
            bool returnsResponse = member.TypeIdentity ==
                "cxcore.System.Threading.Tasks.Task<cxnet.System.Net.Http.HttpResponseMessage>";
            string taskResultType = GetTaskResultType(member.TypeIdentity);
            bool returnsString = IsStringType(taskResultType);
            bool returnsByteArray = IsByteArrayType(taskResultType);
            bool returnsStream = IsStreamType(taskResultType);
            bool returnsStringResponse = IsRestStringType(taskResultType);
            bool returnsByteArrayResponse = IsRestByteArrayType(taskResultType);
            string wrappedResultType = GetRestResponseValueType(taskResultType);
            bool returnsStreamResponse = IsStreamType(wrappedResultType);
            bool returnsScalarResponse =
                IsSupportedScalarResult(wrappedResultType);
            bool returnsScalar = IsSupportedScalarResult(taskResultType);
            string wrappedListElementIdentity = IsRestDtoCollectionTypeIdentity(
                wrappedResultType)
                ? GetQueryCollectionElementType(wrappedResultType) : "";
            string taskListElementIdentity = IsRestDtoCollectionTypeIdentity(
                taskResultType)
                ? GetQueryCollectionElementType(taskResultType) : "";
            string wrappedDictionaryValueIdentity =
                IsRestDtoDictionaryTypeIdentity(wrappedResultType)
                ? GetQueryMapValueType(wrappedResultType) : "";
            string taskDictionaryValueIdentity =
                IsRestDtoDictionaryTypeIdentity(taskResultType)
                ? GetQueryMapValueType(taskResultType) : "";
            TypeDescriptor wrappedListElementType = wrappedListElementIdentity == ""
                ? null : FindRestDtoType(
                    GetNonNullableTypeIdentity(wrappedListElementIdentity),
                    types, annotations);
            TypeDescriptor taskListElementType = taskListElementIdentity == ""
                ? null : FindRestDtoType(
                    GetNonNullableTypeIdentity(taskListElementIdentity),
                    types, annotations);
            TypeDescriptor wrappedDictionaryValueType =
                wrappedDictionaryValueIdentity == "" ? null :
                FindRestDtoType(
                    GetNonNullableTypeIdentity(wrappedDictionaryValueIdentity),
                    types, annotations);
            TypeDescriptor taskDictionaryValueType = taskDictionaryValueIdentity == ""
                ? null : FindRestDtoType(
                    GetNonNullableTypeIdentity(taskDictionaryValueIdentity),
                    types, annotations);
            bool returnsJsonListResponse =
                !IsByteArrayType(wrappedResultType) &&
                wrappedListElementIdentity != "" &&
                IsSupportedJsonCollectionValue(wrappedListElementIdentity,
                    wrappedListElementType);
            bool returnsJsonList = !IsByteArrayType(taskResultType) &&
                taskListElementIdentity != "" &&
                IsSupportedJsonCollectionValue(taskListElementIdentity,
                    taskListElementType);
            bool returnsJsonDictionaryResponse =
                wrappedDictionaryValueIdentity != "" &&
                (wrappedDictionaryValueType != null ||
                 IsSupportedJsonMapValue(wrappedDictionaryValueIdentity,
                    types, annotations));
            bool returnsJsonDictionary = taskDictionaryValueIdentity != "" &&
                (taskDictionaryValueType != null ||
                 IsSupportedJsonMapValue(taskDictionaryValueIdentity,
                    types, annotations));
            bool isNullableScalarResponse = returnsScalarResponse &&
                IsNullableScalarResult(wrappedResultType);
            bool isNullableScalar = returnsScalar &&
                IsNullableScalarResult(taskResultType);
            string nonNullableWrappedResultType =
                GetNonNullableTypeIdentity(wrappedResultType);
            TypeDescriptor wrappedJsonType = FindRestDtoType(
                nonNullableWrappedResultType, types, annotations);
            bool returnsJsonResponse = wrappedJsonType != null;
            bool isNullableJsonResponse = returnsJsonResponse &&
                IsNullableTypeIdentity(wrappedResultType);
            string nonNullableTaskResultType =
                GetNonNullableTypeIdentity(taskResultType);
            TypeDescriptor jsonResultType = FindRestDtoType(
                nonNullableTaskResultType, types, annotations);
            bool returnsJson = jsonResultType != null;
            bool isNullableJson = returnsJson &&
                IsNullableTypeIdentity(taskResultType);
            bool returnsTask = member.TypeIdentity ==
                "cxcore.System.Threading.Tasks.Task" || member.TypeIdentity ==
                "cxcore.System.Threading.Tasks.TaskHandle";
            if (!returnsResponse && !returnsString && !returnsByteArray && !returnsStream &&
                !returnsStringResponse && !returnsByteArrayResponse &&
                !returnsStreamResponse &&
                !returnsScalarResponse && !returnsScalar &&
                !returnsJsonResponse && !returnsJson &&
                !returnsJsonListResponse && !returnsJsonList &&
                !returnsJsonDictionaryResponse && !returnsJsonDictionary &&
                !returnsTask) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST001",
                    "Supported returns include Task, strings, byte arrays, streams, scalars, DTOs, collections of scalar, string, or DTO values using List<T>, Array<T>, LinkedList<T>, Queue<T>, or Stack<T>, and maps with string keys and scalar, string, or DTO values or collections of those values using Dictionary<string, T>, including nullable elements or values, optional const qualification, and RestResponse<T> wrappers; found " + member.TypeIdentity + ".",
                    DiagnosticSeverity.Error, member.Location));
                continue;
            }
            string returnType = "Task";
            if (returnsResponse) returnType = "Task<HttpResponseMessage>";
            else if (returnsString) returnType = "Task<string>";
            else if (returnsByteArray) returnType = "Task<byte[]>";
            else if (returnsStream) returnType = "Task<Stream>";
            else if (returnsStringResponse)
                returnType = "Task<RestResponse<string>>";
            else if (returnsByteArrayResponse)
                returnType = "Task<RestResponse<byte[]>>";
            else if (returnsStreamResponse)
                returnType = "Task<RestResponse<Stream>>";
            else if (returnsScalar)
                returnType = "Task<" + GetSourceParameterType(taskResultType) + ">";
            else if (returnsScalarResponse)
                returnType = "Task<RestResponse<" +
                    GetSourceParameterType(wrappedResultType) + ">>";
            else if (returnsJsonListResponse)
                returnType = "Task<RestResponse<" +
                    GetRestDtoCollectionSourceType(wrappedResultType,
                        GetRestJsonValueSourceType(wrappedListElementIdentity,
                            wrappedListElementType, types)) + ">>";
            else if (returnsJsonList)
                returnType = "Task<" + GetRestDtoCollectionSourceType(
                    taskResultType,
                    GetRestJsonValueSourceType(taskListElementIdentity,
                        taskListElementType, types)) + ">";
            else if (returnsJsonDictionaryResponse)
                returnType = "Task<RestResponse<" +
                    GetRestDtoDictionarySourceType(wrappedResultType,
                        GetRestJsonMapValueSourceType(
                            wrappedDictionaryValueIdentity,
                            wrappedDictionaryValueType, types, annotations)) + ">>";
            else if (returnsJsonDictionary)
                returnType = "Task<" + GetRestDtoDictionarySourceType(
                    taskResultType,
                    GetRestJsonMapValueSourceType(taskDictionaryValueIdentity,
                        taskDictionaryValueType, types, annotations)) + ">";
            else if (returnsJsonResponse)
                returnType = "Task<RestResponse<" +
                    GetQualifiedSourceTypeName(wrappedJsonType,
                        nonNullableWrappedResultType, types) +
                    (isNullableJsonResponse ? "?" : "") + ">>";
            else if (returnsJson)
                returnType = "Task<" + GetQualifiedSourceTypeName(
                    jsonResultType, nonNullableTaskResultType, types) +
                    (isNullableJson ? "?" : "") + ">";
            string verbName = GetVerbName(verb.MetadataName);
            string verbToken = GetVerbToken(verbName);
            string route = GetRoute(verb);
            if (DecodeStringLiteral(route).Length == 0u) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST005",
                    "HTTP routes must be non-empty string literals.",
                    DiagnosticSeverity.Error, verb.Location));
                continue;
            }
            string decodedRoute = DecodeStringLiteral(route);
            string requestDescriptorName = "__restRequest" + FormatIndex(memberIndex);
            string pathSetup = "        string uri = NormalizeRoute(" +
                requestDescriptorName + "Route);\n";
            string bindingMetadata = "";
            string serializerMetadata = "";
            if (HasRepeatedTargetAnnotation(member.Identity,
                    "cxnet.System.Net.Http.Rest.Authorize", annotations) ||
                HasRepeatedTargetAnnotation(type.Identity,
                    "cxnet.System.Net.Http.Rest.Authorize", annotations) ||
                (declaringTypeIdentity != type.Identity &&
                 HasRepeatedTargetAnnotation(declaringTypeIdentity,
                    "cxnet.System.Net.Http.Rest.Authorize", annotations))) {
                output.ReportDiagnostic(new GeneratorDiagnostic("CXREST021",
                    "An interface or method can have at most one @Authorize annotation.",
                    DiagnosticSeverity.Error, member.Location));
                continue;
            }
            string staticHeaderSetup = GetStaticHeaderSetup(
                type.Identity, declaringTypeIdentity, member.Identity, annotations);
