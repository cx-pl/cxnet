                        "        } catch (Exception exception) { try { request.Dispose(); } catch (Exception) { try { HttpContent cleanupContent = request.Content; if (cleanupContent != null) cleanupContent.Dispose(); } catch (Exception) { } } throw exception; }\n" +
                        "    }\n" + typedResultHelper
                    : "        return " + sendCall + ";\n" +
                        "        } catch (Exception exception) { try { request.Dispose(); } catch (Exception) { try { HttpContent cleanupContent = request.Content; if (cleanupContent != null) cleanupContent.Dispose(); } catch (Exception) { } } throw exception; }\n" +
                        "    }\n"));
        }
        if (!hasMethod) return;
        source.Append(
            "    private string FormatValue(string value) { return value; }\n" +
            "    private string FormatValue(bool value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(char value) { uint scalar = (uint)value; if (scalar > 0x10FFFFu || (scalar >= 0xD800u && scalar <= 0xDFFFu)) throw new ArgumentException(\"REST char parameters must contain a valid Unicode scalar.\", \"value\"); StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private char ParseRestJsonChar(string json) {\n" +
            "        uint start = 0u;\n" +
            "        uint end = json.Length;\n" +
            "        while (start < end && (json.Item[start] == ' ' || json.Item[start] == '\\t' || json.Item[start] == '\\n' || json.Item[start] == '\\r')) start += 1u;\n" +
            "        while (end > start && (json.Item[end - 1u] == ' ' || json.Item[end - 1u] == '\\t' || json.Item[end - 1u] == '\\n' || json.Item[end - 1u] == '\\r')) end -= 1u;\n" +
            "        if (end - start < 2u || json.Item[start] != '\"' || json.Item[end - 1u] != '\"') throw new FormatException(\"REST char response must be a JSON string.\");\n" +
            "        start += 1u;\n" +
            "        end -= 1u;\n" +
            "        if (start >= end) throw new FormatException(\"REST char response must contain one Unicode scalar.\");\n" +
            "        uint scalar;\n" +
            "        if (json.Item[start] == '\\\\') {\n" +
            "            start += 1u;\n" +
            "            if (start >= end) throw new FormatException(\"REST char response contains an incomplete JSON escape.\");\n" +
            "            char escape = json.Item[start];\n" +
            "            start += 1u;\n" +
            "            if (escape == '\"' || escape == '\\\\' || escape == '/') scalar = (uint)escape;\n" +
            "            else if (escape == 'b') scalar = 8u;\n" +
            "            else if (escape == 'f') scalar = 12u;\n" +
            "            else if (escape == 'n') scalar = 10u;\n" +
            "            else if (escape == 'r') scalar = 13u;\n" +
            "            else if (escape == 't') scalar = 9u;\n" +
            "            else if (escape == 'u') {\n" +
            "                scalar = ParseRestJsonHex4(json, start, end);\n" +
            "                start += 4u;\n" +
            "                if (scalar >= 0xD800u && scalar <= 0xDBFFu) {\n" +
            "                    if (end - start < 6u || json.Item[start] != '\\\\' || json.Item[start + 1u] != 'u') throw new FormatException(\"REST char response contains an unpaired high surrogate.\");\n" +
            "                    uint low = ParseRestJsonHex4(json, start + 2u, end);\n" +
            "                    if (low < 0xDC00u || low > 0xDFFFu) throw new FormatException(\"REST char response contains an invalid surrogate pair.\");\n" +
            "                    scalar = 0x10000u + ((scalar - 0xD800u) << 10u) + (low - 0xDC00u);\n" +
            "                    start += 6u;\n" +
            "                } else if (scalar >= 0xDC00u && scalar <= 0xDFFFu) throw new FormatException(\"REST char response contains an unpaired low surrogate.\");\n" +
            "            } else throw new FormatException(\"REST char response contains an invalid JSON escape.\");\n" +
            "        } else {\n" +
            "            scalar = (uint)json.Item[start];\n" +
            "            if (scalar < 0x20u || scalar == 0x22u || (scalar >= 0xD800u && scalar <= 0xDFFFu)) throw new FormatException(\"REST char response contains an invalid raw character.\");\n" +
            "            start += 1u;\n" +
            "        }\n" +
            "        if (start != end || scalar > 0x10FFFFu) throw new FormatException(\"REST char response must contain exactly one Unicode scalar.\");\n" +
            "        return (char)scalar;\n" +
            "    }\n" +
            "    private uint ParseRestJsonHex4(string json, uint start, uint end) {\n" +
            "        if (start > end || end - start < 4u) throw new FormatException(\"REST char response contains an incomplete Unicode escape.\");\n" +
            "        uint value = 0u;\n" +
            "        for (uint index = 0u; index < 4u; index += 1u) {\n" +
            "            char digit = json.Item[start + index];\n" +
            "            uint number;\n" +
            "            if (digit >= '0' && digit <= '9') number = (uint)(digit - '0');\n" +
            "            else if (digit >= 'a' && digit <= 'f') number = (uint)(digit - 'a') + 10u;\n" +
            "            else if (digit >= 'A' && digit <= 'F') number = (uint)(digit - 'A') + 10u;\n" +
            "            else throw new FormatException(\"REST char response contains a non-hexadecimal Unicode escape.\");\n" +
            "            value = value * 16u + number;\n" +
            "        }\n" +
            "        return value;\n" +
            "    }\n" +
            "    private string FormatValue(byte value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(sbyte value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(short value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(ushort value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(int value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(uint value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(long value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(ulong value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(float value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(double value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(decimal value) { StringBuilder result = new StringBuilder(); result.Append(value); return result.ToString(); }\n" +
            "    private string FormatValue(Uuid value) { return value.ToString(); }\n" +
            "    private string ReplacePathParameter(string route, string token, string value) {\n" +
            "        StringBuilder result = new StringBuilder();\n" +
            "        uint index = 0u;\n" +
            "        while (index < route.Length) {\n" +
            "            bool matches = index + token.Length <= route.Length;\n" +
            "            for (uint offset = 0u; matches && offset < token.Length; offset += 1u) {\n" +
            "                if (route.Item[index + offset] != token.Item[offset]) matches = false;\n" +
            "            }\n" +
            "            if (matches) { result.Append(value); index += token.Length; }\n" +
            "            else { result.Append(route.Item[index]); index += 1u; }\n" +
            "        }\n" +
            "        return result.ToString();\n" +
            "    }\n" +
            "    private string NormalizeRoute(string route) {\n" +
            "        uint start = 0u;\n" +
            "        while (start < route.Length && route.Item[start] == '/') start += 1u;\n" +
            "        StringBuilder result = new StringBuilder();\n" +
            "        for (uint index = start; index < route.Length; index += 1u) result.Append(route.Item[index]);\n" +
            "        return result.ToString();\n" +
            "    }\n" +
            "    private string AppendQuery(string uri, string name, string value) {\n" +
            "        uint fragmentStart = uri.Length;\n" +
            "        for (uint index = 0u; index < uri.Length; index += 1u)\n" +
            "            if (uri.Item[index] == '#') { fragmentStart = index; break; }\n" +
            "        StringBuilder queryUriBuilder = new StringBuilder();\n" +
            "        for (uint index = 0u; index < fragmentStart; index += 1u)\n" +
            "            queryUriBuilder.Append(uri.Item[index]);\n" +
            "        string queryUri = queryUriBuilder.ToString();\n" +
            "        StringBuilder fragmentBuilder = new StringBuilder();\n" +
            "        for (uint index = fragmentStart; index < uri.Length; index += 1u)\n" +
            "            fragmentBuilder.Append(uri.Item[index]);\n" +
            "        string fragment = fragmentBuilder.ToString();\n" +
            "        bool hasQuery = false;\n" +
            "        for (uint index = 0u; index < queryUri.Length; index += 1u)\n" +
            "            if (queryUri.Item[index] == '?') hasQuery = true;\n" +
            "        string separator = hasQuery ? \"&\" : \"?\";\n" +
            "        if (queryUri.Length > 0u && (queryUri.Item[queryUri.Length - 1u] == '?' || queryUri.Item[queryUri.Length - 1u] == '&'))\n" +
            "            return queryUri + Uri.EscapeDataString(name) + \"=\" + value + fragment;\n" +
            "        return queryUri + separator + Uri.EscapeDataString(name) + \"=\" + value + fragment;\n" +
            "    }\n" +
            "}\n\n" +
            "public static class " + registrationName + " {\n" +
            "    private static bool _registered = RestClient.RegisterGeneratedContract(\n" +
            "        typeof(" + contractTypeName + "), Create);\n" +
            "    private static object Create(RestClient client) {\n" +
            "        return new " + clientName + "(client);\n" +
            "    }\n" +
            "}\n");
        output.AddSource(clientName + ".g.cx", source.ToString());
    }

    private string GetNonGenericTypeName(string name) {
        uint arityStart = name.Length;
        for (uint index = 0u; index < name.Length; index += 1u)
            if (name.Item[index] == '`') { arityStart = index; break; }
        StringBuilder result = new StringBuilder();
        for (uint index = 0u; index < arityStart; index += 1u)
            result.Append(name.Item[index]);
        return result.ToString();
    }

    private string GetClosedInterfaceSourceTypeName(TypeDescriptor type,
        string[] arguments, TypeDescriptor[] types) {
        string name = GetNonGenericTypeName(GetSimpleName(type.MetadataName));
        if (arguments.Length == 0u)
            return type.NamespaceName.Length == 0u ? name : type.NamespaceName + "." + name;
        StringBuilder result = new StringBuilder();
        result.Append(name);
        result.Append('<');
        for (uint index = 0u; index < arguments.Length; index += 1u) {
            if (index > 0u) result.Append(", ");
            result.Append(GetClosedArgumentSourceName(arguments[index], types));
        }
        result.Append('>');
        string closedName = result.ToString();
        return type.NamespaceName.Length == 0u
            ? closedName : type.NamespaceName + "." + closedName;
    }

    private string GetClosedContractNameSuffix(string[] arguments) {
        if (arguments.Length == 0u) return "";
        StringBuilder result = new StringBuilder();
        for (uint argumentIndex = 0u; argumentIndex < arguments.Length;
            argumentIndex += 1u) {
            result.Append('_');
            string argument = arguments[argumentIndex];
            for (uint index = 0u; index < argument.Length; index += 1u) {
                char value = argument.Item[index];
                if ((value >= 'A' && value <= 'Z') ||
                    (value >= 'a' && value <= 'z') ||
                    (value >= '0' && value <= '9')) {
                    result.Append(value);
                } else {
                    result.Append('_');
                    StringBuilder code = new StringBuilder();
                    code.Append((uint)value);
                    result.Append(code.ToString());
                    result.Append('_');
                }
            }
        }
        return result.ToString();
    }

    private bool HasAnnotatedMethod(MemberDescriptor[] members,
        AnnotationDescriptor[] annotations) {
        for (uint memberIndex = 0u; memberIndex < members.Length; memberIndex += 1u) {
            MemberDescriptor member = members[memberIndex];
            if (member.Kind == GeneratorValueKind.Method && !member.IsStatic &&
                FindVerbIndex(member, annotations) >= 0) return true;
        }
        return false;
    }

    private string AppendBindingDescriptor(string current, string kind,
        string name, string typeIdentity) {
        return AppendBindingDescriptorWithExtra(current, kind, name,
            typeIdentity, "");
    }

    private string AppendBindingDescriptorWithExtra(string current, string kind,
        string name, string typeIdentity, string extra) {
        return current + EncodeDescriptorValue(kind) + EncodeDescriptorValue(name) +
            EncodeDescriptorValue(typeIdentity) + EncodeDescriptorValue(extra);
    }

    private string AppendStaticHeaderDescriptors(string current,
        string targetIdentity, AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(targetIdentity);
        if (indices == null) return current;
        string result = current;
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity != targetIdentity ||
                annotation.MetadataName != "cxnet.System.Net.Http.Rest.StaticHeader")
                continue;
            result = AppendBindingDescriptorWithExtra(result, "StaticHeader",
                DecodeStringLiteral(GetNamedArgument(annotation, "name")),
                "System.String",
                DecodeStringLiteral(GetNamedArgument(annotation, "value")));
        }
        return result;
    }

    private string AppendSerializerDescriptor(string current, string direction,
        string entryPoint, string typeIdentity) {
        return current + EncodeDescriptorValue(direction) +
            EncodeDescriptorValue(entryPoint) + EncodeDescriptorValue(typeIdentity);
    }

    private string EncodeDescriptorValue(string value) {
        StringBuilder length = new StringBuilder();
        length.Append(value.Length);
        return length.ToString() + ":" + value;
    }

    private string GetSimpleName(string metadataName) {
        uint start = 0u;
        for (uint index = 0u; index < metadataName.Length; index += 1u) {
            if (metadataName.Item[index] == '.') start = index + 1u;
        }
        StringBuilder result = new StringBuilder();
        for (uint index = start; index < metadataName.Length; index += 1u) {
            result.Append(metadataName.Item[index]);
        }
        return result.ToString();
    }

    private string FormatIndex(uint value) {
        StringBuilder result = new StringBuilder();
        result.Append(value);
        return result.ToString();
    }

    private int FindVerbIndex(MemberDescriptor member,
        AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(member.Identity);
        if (indices == null) return -1;
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity == member.Identity &&
                (annotation.MetadataName == "cxnet.System.Net.Http.Rest.Get" ||
                 annotation.MetadataName == "cxnet.System.Net.Http.Rest.Post" ||
                 annotation.MetadataName == "cxnet.System.Net.Http.Rest.Put" ||
                 annotation.MetadataName == "cxnet.System.Net.Http.Rest.Patch" ||
                 annotation.MetadataName == "cxnet.System.Net.Http.Rest.Delete" ||
                 annotation.MetadataName == "cxnet.System.Net.Http.Rest.Head" ||
                 annotation.MetadataName == "cxnet.System.Net.Http.Rest.Options"))
                return (int)index;
        }
        return -1;
    }

    private uint CountVerbAnnotations(MemberDescriptor member,
        AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(member.Identity);
        if (indices == null) return 0u;
        uint count = 0u;
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity != member.Identity) continue;
            if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.Get" ||
                annotation.MetadataName == "cxnet.System.Net.Http.Rest.Post" ||
                annotation.MetadataName == "cxnet.System.Net.Http.Rest.Put" ||
                annotation.MetadataName == "cxnet.System.Net.Http.Rest.Patch" ||
                annotation.MetadataName == "cxnet.System.Net.Http.Rest.Delete" ||
                annotation.MetadataName == "cxnet.System.Net.Http.Rest.Head" ||
                annotation.MetadataName == "cxnet.System.Net.Http.Rest.Options") {
                count += 1u;
            }
        }
        return count;
    }

    private int FindParameterAnnotation(string targetIdentity, string metadataName,
        AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(targetIdentity);
        if (indices == null) return -1;
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity == targetIdentity &&
                annotation.MetadataName == metadataName) return (int)index;
        }
        return -1;
    }

    private bool HasRepeatedTargetAnnotation(string targetIdentity,
        string metadataName, AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(targetIdentity);
        if (indices == null) return false;
        uint count = 0u;
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity == targetIdentity &&
                annotation.MetadataName == metadataName) {
                count += 1u;
                if (count > 1u) return true;
            }
        }
        return false;
    }

    private bool IsHttpToken(string value) {
        if (value.Length == 0u) return false;
        for (uint index = 0u; index < value.Length; index += 1u) {
            char current = value.Item[index];
            if ((current >= 'A' && current <= 'Z') ||
                (current >= 'a' && current <= 'z') ||
                (current >= '0' && current <= '9') || current == '!' ||
                current == '#' || current == '$' || current == '%' ||
                current == '&' || current == '\'' || current == '*' ||
                current == '+' || current == '-' || current == '.' ||
                current == '^' || current == '_' || current == '`' ||
                current == '|' || current == '~') continue;
            return false;
        }
        return true;
    }

    private bool IsValidHttpFieldValue(string value) {
        for (uint index = 0u; index < value.Length; index += 1u) {
            char current = value.Item[index];
            if ((current < ' ' && current != '\t') || current == (char)0x7Fu)
                return false;
        }
        return true;
    }

    private bool EqualsHttpHeaderName(string value, string expected) {
        if (value.Length != expected.Length) return false;
        for (uint index = 0u; index < value.Length; index += 1u) {
            char actual = value.Item[index];
            char wanted = expected.Item[index];
            if (actual >= 'A' && actual <= 'Z')
                actual = (char)((uint)actual + 32u);
            if (wanted >= 'A' && wanted <= 'Z')
                wanted = (char)((uint)wanted + 32u);
            if (actual != wanted) return false;
        }
        return true;
    }

    private bool HasValidStaticHeaders(string targetIdentity,
        AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(targetIdentity);
        if (indices == null) return true;
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity != targetIdentity ||
                annotation.MetadataName != "cxnet.System.Net.Http.Rest.StaticHeader")
                continue;
            string name = DecodeStringLiteral(GetNamedArgument(annotation, "name"));
            string value = DecodeStringLiteral(GetNamedArgument(annotation, "value"));
            if (!IsHttpToken(name) || !IsValidHttpFieldValue(value) ||
                EqualsHttpHeaderName(name, "Content-Length") ||
                EqualsHttpHeaderName(name, "Transfer-Encoding")) return false;
        }
        return true;
    }

    private bool HasRepeatedParameterBinding(string targetIdentity,
        AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(targetIdentity);
        if (indices == null) return false;
        uint pathCount = 0u;
        uint aliasCount = 0u;
        uint queryCount = 0u;
        uint queryMapCount = 0u;
        uint headerCount = 0u;
        uint bodyCount = 0u;
        uint formCount = 0u;
        uint multipartCount = 0u;
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity != targetIdentity) continue;
            if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.Path")
                pathCount += 1u;
            else if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.AliasAs")
                aliasCount += 1u;
            else if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.Query")
                queryCount += 1u;
            else if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.QueryMap")
                queryMapCount += 1u;
            else if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.Header")
                headerCount += 1u;
            else if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.Body")
                bodyCount += 1u;
            else if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.FormField")
                formCount += 1u;
            else if (annotation.MetadataName == "cxnet.System.Net.Http.Rest.MultipartPart")
                multipartCount += 1u;
        }
        return pathCount > 1u || aliasCount > 1u || queryCount > 1u ||
            queryMapCount > 1u || headerCount > 1u || bodyCount > 1u ||
            formCount > 1u || multipartCount > 1u;
    }

    private string GetStaticHeaderSetup(string typeIdentity, string declaringTypeIdentity,
        string methodIdentity,
        AnnotationDescriptor[] annotations) {
        string result = AppendStaticHeadersForTarget(declaringTypeIdentity, annotations);
        if (declaringTypeIdentity != typeIdentity)
            result = result + AppendStaticHeadersForTarget(typeIdentity, annotations);
        result = result + AppendStaticHeadersForTarget(methodIdentity, annotations);
        return result;
    }

    private string GetAuthorizationScheme(string typeIdentity, string declaringTypeIdentity,
        string methodIdentity,
        AnnotationDescriptor[] annotations) {
        int methodIndex = FindParameterAnnotation(methodIdentity,
            "cxnet.System.Net.Http.Rest.Authorize", annotations);
        if (methodIndex >= 0)
            return GetNamedArgument(annotations[(uint)methodIndex], "scheme");
        int typeIndex = FindParameterAnnotation(typeIdentity,
            "cxnet.System.Net.Http.Rest.Authorize", annotations);
        if (typeIndex >= 0)
            return GetNamedArgument(annotations[(uint)typeIndex], "scheme");
        if (declaringTypeIdentity != typeIdentity) {
            int declaringIndex = FindParameterAnnotation(declaringTypeIdentity,
                "cxnet.System.Net.Http.Rest.Authorize", annotations);
            if (declaringIndex >= 0)
                return GetNamedArgument(annotations[(uint)declaringIndex], "scheme");
        }
        return "";
    }

    private string GetDeclaringInterfaceIdentity(MemberDescriptor member,
        TypeDescriptor[] types, string fallbackIdentity) {
        string identity = _declaringTypeIdentities.GetValueOrDefault(member.Identity);
        return identity == null ? fallbackIdentity : identity;
    }

    private string AppendStaticHeadersForTarget(string targetIdentity,
        AnnotationDescriptor[] annotations) {
        List<uint> indices = _annotationIndices.GetValueOrDefault(targetIdentity);
        if (indices == null) return "";
        string result = "";
        for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
            uint index = indices.Get(cursor);
            AnnotationDescriptor annotation = annotations[index];
            if (annotation.TargetIdentity != targetIdentity ||
                annotation.MetadataName != "cxnet.System.Net.Http.Rest.StaticHeader")
                continue;
            string name = GetNamedArgument(annotation, "name");
            string value = GetNamedArgument(annotation, "value");
            result = result + "        request.Headers.Remove(" + name + ");\n" +
                "        request.Headers.Add(" + name + ", " + value + ");\n";
        }
        return result;
    }

    private bool IsSupportedRequestValue(string typeIdentity) {
        return typeIdentity == "cxcore.System.String" || typeIdentity == "System.String" ||
            typeIdentity == "cxcore.System.String?" || typeIdentity == "System.String?" ||
            IsUuidType(typeIdentity) ||
            typeIdentity == "System.Bool" || typeIdentity == "System.Char" ||
            typeIdentity == "cxcore.System.Char" ||
            typeIdentity == "System.Byte" ||
            typeIdentity == "System.SByte" || typeIdentity == "System.Short" ||
            typeIdentity == "System.UShort" || typeIdentity == "System.Int" ||
            typeIdentity == "System.UInt" || typeIdentity == "System.Long" ||
            typeIdentity == "System.ULong" || typeIdentity == "System.Float" ||
            typeIdentity == "System.Double" || typeIdentity == "System.Decimal";
    }

    private bool IsSupportedRequestElement(string typeIdentity) {
        return IsSupportedRequestValue(
            IsNullableTypeIdentity(typeIdentity)
                ? GetNonNullableTypeIdentity(typeIdentity) : typeIdentity);
    }

    private string GetRequestElementValue(string expression, string typeIdentity) {
        if (!IsNullableTypeIdentity(typeIdentity)) return expression;
        string valueType = GetNonNullableTypeIdentity(typeIdentity);
        string fallback = IsStringType(valueType)
            ? "\"\"" : GetNullableScalarFallback(valueType);
        return expression + " ?? " + fallback;
    }

    private string GetNullableScalarFallback(string typeIdentity) {
        if (IsUuidType(typeIdentity)) return "Uuid.Zero";
        if (typeIdentity == "System.Bool") return "false";
        if (typeIdentity == "System.Char" ||
            typeIdentity == "cxcore.System.Char") return "(char)0u";
        if (typeIdentity == "System.Byte") return "(byte)0";
        if (typeIdentity == "System.SByte") return "(sbyte)0";
        if (typeIdentity == "System.Short") return "(short)0";
        if (typeIdentity == "System.UShort") return "(ushort)0";
        if (typeIdentity == "System.UInt") return "0u";
        if (typeIdentity == "System.Long") return "(long)0";
        if (typeIdentity == "System.ULong") return "(ulong)0";
        if (typeIdentity == "System.Float") return "(float)0.0";
        if (typeIdentity == "System.Double") return "0.0";
        if (typeIdentity == "System.Decimal") return "0m";
        return "0";
    }

    private string GetQueryCollectionElementType(string typeIdentity) {
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        if (IsNullableTypeIdentity(typeIdentity))
            typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (typeIdentity.Length > 2u &&
            typeIdentity.Item[typeIdentity.Length - 2u] == '[' &&
            typeIdentity.Item[typeIdentity.Length - 1u] == ']') {
            StringBuilder arrayElementType = new StringBuilder();
            for (uint index = 0u; index < typeIdentity.Length - 2u; index += 1u)
                arrayElementType.Append(typeIdentity.Item[index]);
            return arrayElementType.ToString();
        }
        string systemPrefix = "System.Collections.IEnumerable<";
        string corePrefix = "cxcore.System.Collections.IEnumerable<";
        string systemCollectionPrefix = "System.Collections.ICollection<";
        string coreCollectionPrefix = "cxcore.System.Collections.ICollection<";
        string systemListPrefix = "System.Collections.List<";
        string coreListPrefix = "cxcore.System.Collections.List<";
        string systemArrayCollectionPrefix = "System.Collections.Array<";
        string coreArrayCollectionPrefix = "cxcore.System.Collections.Array<";
        string systemLinkedListPrefix = "System.Collections.LinkedList<";
        string coreLinkedListPrefix = "cxcore.System.Collections.LinkedList<";
        string systemQueuePrefix = "System.Collections.Queue<";
        string coreQueuePrefix = "cxcore.System.Collections.Queue<";
        string systemStackPrefix = "System.Collections.Stack<";
        string coreStackPrefix = "cxcore.System.Collections.Stack<";
        string prefix = "";
        if (HasPrefix(typeIdentity, corePrefix)) prefix = corePrefix;
        if (prefix == "" && HasPrefix(typeIdentity, systemPrefix)) prefix = systemPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, coreCollectionPrefix))
            prefix = coreCollectionPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, systemCollectionPrefix))
            prefix = systemCollectionPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, coreArrayCollectionPrefix))
            prefix = coreArrayCollectionPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, systemArrayCollectionPrefix))
            prefix = systemArrayCollectionPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, coreListPrefix)) prefix = coreListPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, systemListPrefix)) prefix = systemListPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, coreLinkedListPrefix))
            prefix = coreLinkedListPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, systemLinkedListPrefix))
            prefix = systemLinkedListPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, coreQueuePrefix)) prefix = coreQueuePrefix;
        if (prefix == "" && HasPrefix(typeIdentity, systemQueuePrefix)) prefix = systemQueuePrefix;
        if (prefix == "" && HasPrefix(typeIdentity, coreStackPrefix)) prefix = coreStackPrefix;
        if (prefix == "" && HasPrefix(typeIdentity, systemStackPrefix)) prefix = systemStackPrefix;
        if (prefix == "" || typeIdentity.Length <= prefix.Length ||
            typeIdentity.Item[typeIdentity.Length - 1u] != '>') return "";
        StringBuilder elementType = new StringBuilder();
        for (uint index = prefix.Length; index < typeIdentity.Length - 1u; index += 1u)
            elementType.Append(typeIdentity.Item[index]);
        return elementType.ToString();
    }

    private bool IsQueryMapType(string typeIdentity) {
        if (IsNullableTypeIdentity(typeIdentity))
            typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return HasPrefix(typeIdentity,
                "System.Collections.Dictionary<") ||
            HasPrefix(typeIdentity, "cxcore.System.Collections.Dictionary<");
    }

    private string GetQueryMapValueType(string typeIdentity) {
        if (IsNullableTypeIdentity(typeIdentity))
            typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        string prefix = HasPrefix(typeIdentity,
            "cxcore.System.Collections.Dictionary<")
            ? "cxcore.System.Collections.Dictionary<"
            : (HasPrefix(typeIdentity, "System.Collections.Dictionary<")
                ? "System.Collections.Dictionary<" : "");
        if (prefix == "" || typeIdentity.Item[typeIdentity.Length - 1u] != '>')
            return "";
        uint comma = prefix.Length;
        uint genericDepth = 0u;
        while (comma < typeIdentity.Length - 1u) {
            char current = typeIdentity.Item[comma];
            if (current == '<') genericDepth += 1u;
            else if (current == '>') genericDepth -= 1u;
            else if (current == ',' && genericDepth == 0u) break;
            comma += 1u;
        }
        if (comma >= typeIdentity.Length - 1u) return "";
        string keyType = Extract(typeIdentity, prefix.Length, comma);
        if (keyType != "System.String" && keyType != "cxcore.System.String")
            return "";
        return Extract(typeIdentity, comma + 1u, typeIdentity.Length - 1u);
    }

    private string GetEmptyQueryMapCollectionExpression(string collectionType,
        string elementType) {
        if (IsNullableTypeIdentity(collectionType))
            collectionType = GetNonNullableTypeIdentity(collectionType);
        if (HasPrefix(collectionType, "const "))
            collectionType = Extract(collectionType, 6u, collectionType.Length);
        string sourceElementType = GetSourceParameterType(elementType);
        if (IsArrayTypeIdentity(collectionType))
            return "new " + sourceElementType + "[0u]";
        if (IsListTypeIdentity(collectionType))
            return "new List<" + sourceElementType + ">()";
        if (IsLinkedListTypeIdentity(collectionType))
            return "new LinkedList<" + sourceElementType + ">()";
        if (IsQueueTypeIdentity(collectionType))
            return "new Queue<" + sourceElementType + ">()";
        if (IsStackTypeIdentity(collectionType))
            return "new Stack<" + sourceElementType + ">()";
        return "new Array<" + sourceElementType + ">(0u)";
    }

    private string Extract(string value, uint start, uint end) {
        StringBuilder result = new StringBuilder();
        for (uint index = start; index < end; index += 1u)
            result.Append(value.Item[index]);
        return result.ToString();
    }

    private bool HasPrefix(string value, string prefix) {
        if (value.Length < prefix.Length) return false;
        for (uint index = 0u; index < prefix.Length; index += 1u) {
            if (value.Item[index] != prefix.Item[index]) return false;
        }
        return true;
    }

    private string GetTaskResultType(string typeIdentity) {
        string prefix = "cxcore.System.Threading.Tasks.Task<";
        if (!HasPrefix(typeIdentity, prefix) ||
            typeIdentity.Item[typeIdentity.Length - 1u] != '>') return "";
        StringBuilder resultType = new StringBuilder();
        for (uint index = prefix.Length; index < typeIdentity.Length - 1u; index += 1u)
            resultType.Append(typeIdentity.Item[index]);
        return resultType.ToString();
    }

    private bool IsStringType(string typeIdentity) {
        return typeIdentity == "System.String" ||
            typeIdentity == "cxcore.System.String";
    }

    private bool IsUuidType(string typeIdentity) {
        return typeIdentity == "System.Uuid" ||
            typeIdentity == "cxcore.System.Uuid";
    }

    private bool IsByteArrayType(string typeIdentity) {
        return typeIdentity == "System.Byte[]" ||
            typeIdentity == "cxcore.System.Byte[]";
    }

    private bool IsByteArrayBodyType(string typeIdentity) {
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return IsByteArrayType(typeIdentity);
    }

    private bool IsStreamType(string typeIdentity) {
        return typeIdentity == "System.IO.Stream" ||
            typeIdentity == "cxcore.System.IO.Stream";
    }

    private bool IsRestStringType(string typeIdentity) {
        string valueType = GetRestResponseValueType(typeIdentity);
        return IsStringType(valueType);
    }

    private bool IsRestByteArrayType(string typeIdentity) {
        string valueType = GetRestResponseValueType(typeIdentity);
        return IsByteArrayType(valueType);
    }

    private bool IsSupportedScalarResult(string typeIdentity) {
        string scalarType = GetNonNullableTypeIdentity(typeIdentity);
        return IsSupportedRequestValue(scalarType) && !IsStringType(scalarType);
    }

    private bool IsSupportedJsonMapValue(string typeIdentity,
        TypeDescriptor[] types, AnnotationDescriptor[] annotations) {
        string nonNullableTypeIdentity =
            GetNonNullableTypeIdentity(typeIdentity);
        if (IsStringType(nonNullableTypeIdentity) ||
            IsSupportedScalarResult(nonNullableTypeIdentity)) return true;
        if (!IsRestDtoCollectionTypeIdentity(nonNullableTypeIdentity))
            return false;
        string elementIdentity = GetQueryCollectionElementType(
            nonNullableTypeIdentity);
        if (elementIdentity == "") return false;
        TypeDescriptor elementType = FindRestDtoType(
            GetNonNullableTypeIdentity(elementIdentity), types, annotations);
        return IsSupportedJsonCollectionValue(elementIdentity, elementType);
    }

    private bool IsSupportedJsonCollectionValue(string typeIdentity,
        TypeDescriptor dtoType) {
        string nonNullableTypeIdentity =
            GetNonNullableTypeIdentity(typeIdentity);
        return dtoType != null || IsStringType(nonNullableTypeIdentity) ||
            IsSupportedScalarResult(nonNullableTypeIdentity);
    }

    private string GetNonNullableTypeIdentity(string typeIdentity) {
        if (typeIdentity.Length == 0u ||
            typeIdentity.Item[typeIdentity.Length - 1u] != '?') return typeIdentity;
        StringBuilder result = new StringBuilder();
        for (uint index = 0u; index < typeIdentity.Length - 1u; index += 1u)
            result.Append(typeIdentity.Item[index]);
        return result.ToString();
    }

    private bool IsNullableScalarResult(string typeIdentity) {
        return typeIdentity.Length > 0u &&
            typeIdentity.Item[typeIdentity.Length - 1u] == '?' &&
            IsSupportedScalarResult(typeIdentity);
    }

    private string GetJsonNullCheckCode(string responseTextName, string suffix,
        string resultName) {
        string startName = "jsonNullStart" + suffix;
        string endName = "jsonNullEnd" + suffix;
        string startWhitespace = responseTextName + ".Item[" + startName +
            "] == ' ' || " + responseTextName + ".Item[" + startName +
            "] == '\\t' || " + responseTextName + ".Item[" + startName +
            "] == '\\n' || " + responseTextName + ".Item[" + startName +
            "] == '\\r'";
        string endWhitespace = responseTextName + ".Item[" + endName +
            " - 1u] == ' ' || " + responseTextName + ".Item[" + endName +
            " - 1u] == '\\t' || " + responseTextName + ".Item[" + endName +
            " - 1u] == '\\n' || " + responseTextName + ".Item[" + endName +
            " - 1u] == '\\r'";
        return "                uint " + startName + " = 0u;\n" +
            "                uint " + endName + " = " + responseTextName +
                ".Length;\n" +
            "                while (" + startName + " < " + endName +
                " && (" + startWhitespace + ")) " + startName + " += 1u;\n" +
            "                while (" + endName + " > " + startName +
                " && (" + endWhitespace + ")) " + endName + " -= 1u;\n" +
            "                bool " + resultName + " = " + endName + " - " +
                startName + " == 4u && " + responseTextName + ".Item[" +
                startName + "] == 'n' && " + responseTextName + ".Item[" +
                startName + " + 1u] == 'u' && " + responseTextName + ".Item[" +
                startName + " + 2u] == 'l' && " + responseTextName + ".Item[" +
                startName + " + 3u] == 'l';\n";
    }

    private string GetScalarResultParseCode(string typeIdentity,
        string sourceTypeName, string responseTextName, string valueName) {
        if (typeIdentity == "System.Char" ||
            typeIdentity == "cxcore.System.Char") {
            return "                char " + valueName + " = ParseRestJsonChar(" +
                responseTextName + ");\n";
        }
        if (IsUuidType(typeIdentity)) {
            string startName = valueName + "Start";
            string endName = valueName + "End";
            string indexName = valueName + "Index";
            string characterName = valueName + "Character";
            string escapeName = valueName + "Escape";
            string digitName = valueName + "Digit";
            string codeName = valueName + "Code";
            string digitValueName = valueName + "DigitValue";
            string whitespace = responseTextName + ".Item[" + startName +
                "] == ' ' || " + responseTextName + ".Item[" + startName +
                "] == '\\t' || " + responseTextName + ".Item[" + startName +
                "] == '\\n' || " + responseTextName + ".Item[" + startName +
                "] == '\\r'";
            string trailingWhitespace = responseTextName + ".Item[" + endName +
                " - 1u] == ' ' || " + responseTextName + ".Item[" + endName +
                " - 1u] == '\\t' || " + responseTextName + ".Item[" + endName +
                " - 1u] == '\\n' || " + responseTextName + ".Item[" + endName +
                " - 1u] == '\\r'";
            return "                uint " + startName + " = 0u;\n" +
                "                uint " + endName + " = " + responseTextName +
                    ".Length;\n" +
                "                while (" + startName + " < " + endName +
                    " && (" + whitespace + ")) " + startName + " += 1u;\n" +
                "                while (" + endName + " > " + startName +
                    " && (" + trailingWhitespace + ")) " + endName + " -= 1u;\n" +
                "                if (" + endName + " - " + startName +
                    " < 2u || " + responseTextName + ".Item[" + startName +
                    "] != '\"' || " + responseTextName + ".Item[" + endName +
                    " - 1u] != '\"') throw new FormatException(\"REST response body is not a JSON UUID string.\");\n" +
                "                StringBuilder " + valueName + "Builder = new StringBuilder(36u);\n" +
                "                for (uint " + indexName + " = " + startName +
                    " + 1u; " + indexName + " < " + endName + " - 1u; " +
                    indexName + " += 1u) {\n" +
                "                    char " + characterName + " = " + responseTextName +
                    ".Item[" + indexName + "];\n" +
                "                    if (" + characterName + " == '\\\\') {\n" +
                "                        " + indexName + " += 1u;\n" +
                "                        if (" + indexName + " >= " + endName +
                    " - 1u) throw new FormatException(\"REST response body contains an invalid JSON string escape.\");\n" +
                "                        char " + escapeName + " = " + responseTextName +
                    ".Item[" + indexName + "];\n" +
                "                        if (" + escapeName + " == 'u') {\n" +
                "                            uint " + codeName + " = 0u;\n" +
                "                            for (uint " + digitName + " = 0u; " +
                    digitName + " < 4u; " + digitName + " += 1u) {\n" +
                "                                " + indexName + " += 1u;\n" +
                "                                if (" + indexName + " >= " + endName +
                    " - 1u) throw new FormatException(\"REST response body contains an incomplete JSON Unicode escape.\");\n" +
                "                                char " + digitValueName + " = " +
                    responseTextName + ".Item[" + indexName + "];\n" +
                "                                uint digit;\n" +
                "                                if (" + digitValueName + " >= '0' && " +
                    digitValueName + " <= '9') digit = (uint)(" + digitValueName + " - '0');\n" +
                "                                else if (" + digitValueName + " >= 'a' && " +
                    digitValueName + " <= 'f') digit = (uint)(" + digitValueName + " - 'a') + 10u;\n" +
                "                                else if (" + digitValueName + " >= 'A' && " +
                    digitValueName + " <= 'F') digit = (uint)(" + digitValueName + " - 'A') + 10u;\n" +
                "                                else throw new FormatException(\"REST response body contains an invalid JSON Unicode escape.\");\n" +
                "                                " + codeName + " = " + codeName + " * 16u + digit;\n" +
                "                            }\n" +
                "                            " + characterName + " = (char)" + codeName + ";\n" +
                "                        } else if (" + escapeName + " == '\"' || " +
                    escapeName + " == '\\\\' || " + escapeName + " == '/') " +
                    characterName + " = " + escapeName + ";\n" +
                "                        else if (" + escapeName + " == 'b') " +
                    characterName + " = (char)8u;\n" +
                "                        else if (" + escapeName + " == 'f') " +
                    characterName + " = (char)12u;\n" +
                "                        else if (" + escapeName + " == 'n') " +
                    characterName + " = (char)10u;\n" +
                "                        else if (" + escapeName + " == 'r') " +
                    characterName + " = (char)13u;\n" +
                "                        else if (" + escapeName + " == 't') " +
                    characterName + " = (char)9u;\n" +
                "                        else throw new FormatException(\"REST response body contains an invalid JSON string escape.\");\n" +
                "                    } else if (" + characterName + " < ' ') throw new FormatException(\"REST response body contains an invalid JSON string character.\");\n" +
                "                    if (" + valueName + "Builder.Length >= 36u) throw new FormatException(\"REST response body is not a canonical UUID.\");\n" +
                "                    " + valueName + "Builder.Append(" + characterName + ");\n" +
                "                }\n" +
                "                " + sourceTypeName + " " + valueName + " = Uuid.Parse(" +
                    valueName + "Builder.ToString());\n";
        }
        if (typeIdentity == "System.Bool") {
            string startName = valueName + "Start";
            string endName = valueName + "End";
            string startWhitespace = responseTextName + ".Item[" + startName +
                "] == ' ' || " + responseTextName + ".Item[" + startName +
                "] == '\\t' || " + responseTextName + ".Item[" + startName +
                "] == '\\n' || " + responseTextName + ".Item[" + startName +
                "] == '\\r'";
            string endWhitespace = responseTextName + ".Item[" + endName +
                " - 1u] == ' ' || " + responseTextName + ".Item[" + endName +
                " - 1u] == '\\t' || " + responseTextName + ".Item[" + endName +
                " - 1u] == '\\n' || " + responseTextName + ".Item[" + endName +
                " - 1u] == '\\r'";
            string trueCheck = endName + " - " + startName + " == 4u && " +
                responseTextName + ".Item[" + startName + "] == 't' && " +
                responseTextName + ".Item[" + startName + " + 1u] == 'r' && " +
                responseTextName + ".Item[" + startName + " + 2u] == 'u' && " +
                responseTextName + ".Item[" + startName + " + 3u] == 'e'";
            string falseCheck = endName + " - " + startName + " == 5u && " +
                responseTextName + ".Item[" + startName + "] == 'f' && " +
                responseTextName + ".Item[" + startName + " + 1u] == 'a' && " +
                responseTextName + ".Item[" + startName + " + 2u] == 'l' && " +
                responseTextName + ".Item[" + startName + " + 3u] == 's' && " +
                responseTextName + ".Item[" + startName + " + 4u] == 'e'";
            return "                uint " + startName + " = 0u;\n" +
                "                uint " + endName + " = " + responseTextName +
                    ".Length;\n" +
                "                while (" + startName + " < " + endName +
                    " && (" + startWhitespace + ")) " + startName + " += 1u;\n" +
                "                while (" + endName + " > " + startName +
                    " && (" + endWhitespace + ")) " + endName + " -= 1u;\n" +
                "                bool " + valueName + "IsTrue = " + trueCheck + ";\n" +
                "                bool " + valueName + "IsFalse = " + falseCheck + ";\n" +
                "                if (!" + valueName + "IsTrue && !" + valueName +
                    "IsFalse) throw new FormatException(\"REST response body is not a JSON boolean.\");\n" +
                "                bool " + valueName + " = " + valueName + "IsTrue;\n";
        }
        string parserName = "";
        if (typeIdentity == "System.Byte") parserName = "Byte";
        else if (typeIdentity == "System.SByte") parserName = "SByte";
        else if (typeIdentity == "System.Short") parserName = "Short";
        else if (typeIdentity == "System.UShort") parserName = "UShort";
        else if (typeIdentity == "System.Int") parserName = "Int";
        else if (typeIdentity == "System.UInt") parserName = "UInt";
        else if (typeIdentity == "System.Long") parserName = "Long";
        else if (typeIdentity == "System.ULong") parserName = "ULong";
        else if (typeIdentity == "System.Float") parserName = "Float";
        else if (typeIdentity == "System.Double") parserName = "Double";
        else if (typeIdentity == "System.Decimal") parserName = "Decimal";
        if (parserName == "") return "";
        string numberStartName = valueName + "NumberStart";
        string numberEndName = valueName + "NumberEnd";
        string numberIndexName = valueName + "NumberIndex";
        string numberDigitName = valueName + "NumberDigit";
        string fractionStartName = valueName + "FractionStart";
        string exponentStartName = valueName + "ExponentStart";
        string leadingWhitespace = responseTextName + ".Item[" + numberStartName +
            "] == ' ' || " + responseTextName + ".Item[" + numberStartName +
            "] == '\\t' || " + responseTextName + ".Item[" + numberStartName +
            "] == '\\n' || " + responseTextName + ".Item[" + numberStartName +
            "] == '\\r'";
        string trailingWhitespace = responseTextName + ".Item[" + numberEndName +
            " - 1u] == ' ' || " + responseTextName + ".Item[" + numberEndName +
            " - 1u] == '\\t' || " + responseTextName + ".Item[" + numberEndName +
            " - 1u] == '\\n' || " + responseTextName + ".Item[" + numberEndName +
            " - 1u] == '\\r'";
        string numberValidationCode =
            "                uint " + numberStartName + " = 0u;\n" +
            "                uint " + numberEndName + " = " + responseTextName +
                ".Length;\n" +
            "                while (" + numberStartName + " < " + numberEndName +
                " && (" + leadingWhitespace + ")) " + numberStartName + " += 1u;\n" +
            "                while (" + numberEndName + " > " + numberStartName +
                " && (" + trailingWhitespace + ")) " + numberEndName + " -= 1u;\n" +
            "                uint " + numberIndexName + " = " + numberStartName + ";\n" +
            "                if (" + numberIndexName + " < " + numberEndName +
                " && " + responseTextName + ".Item[" + numberIndexName +
                "] == '-') " + numberIndexName + " += 1u;\n" +
            "                if (" + numberIndexName + " >= " + numberEndName +
                ") throw new FormatException(\"REST response body is not a JSON number.\");\n" +
            "                char " + numberDigitName + " = " + responseTextName +
                ".Item[" + numberIndexName + "];\n" +
            "                if (" + numberDigitName + " == '0') {\n" +
            "                    " + numberIndexName + " += 1u;\n" +
            "                    if (" + numberIndexName + " < " + numberEndName +
                " && " + responseTextName + ".Item[" + numberIndexName +
                "] >= '0' && " + responseTextName + ".Item[" + numberIndexName +
                "] <= '9') throw new FormatException(\"REST response body is not a JSON number.\");\n" +
            "                } else if (" + numberDigitName + " >= '1' && " +
                numberDigitName + " <= '9') {\n" +
            "                    " + numberIndexName + " += 1u;\n" +
            "                    while (" + numberIndexName + " < " + numberEndName +
                " && " + responseTextName + ".Item[" + numberIndexName +
                "] >= '0' && " + responseTextName + ".Item[" + numberIndexName +
                "] <= '9') " + numberIndexName + " += 1u;\n" +
            "                } else throw new FormatException(\"REST response body is not a JSON number.\");\n" +
            "                if (" + numberIndexName + " < " + numberEndName +
                " && " + responseTextName + ".Item[" + numberIndexName + "] == '.') {\n" +
            "                    " + numberIndexName + " += 1u;\n" +
            "                    uint " + fractionStartName + " = " + numberIndexName + ";\n" +
            "                    while (" + numberIndexName + " < " + numberEndName +
                " && " + responseTextName + ".Item[" + numberIndexName +
                "] >= '0' && " + responseTextName + ".Item[" + numberIndexName +
                "] <= '9') " + numberIndexName + " += 1u;\n" +
            "                    if (" + numberIndexName + " == " + fractionStartName +
                ") throw new FormatException(\"REST response body is not a JSON number.\");\n" +
            "                }\n" +
            "                if (" + numberIndexName + " < " + numberEndName +
                " && (" + responseTextName + ".Item[" + numberIndexName +
                "] == 'e' || " + responseTextName + ".Item[" + numberIndexName +
                "] == 'E')) {\n" +
            "                    " + numberIndexName + " += 1u;\n" +
            "                    if (" + numberIndexName + " < " + numberEndName +
                " && (" + responseTextName + ".Item[" + numberIndexName +
                "] == '+' || " + responseTextName + ".Item[" + numberIndexName +
                "] == '-')) " + numberIndexName + " += 1u;\n" +
            "                    uint " + exponentStartName + " = " + numberIndexName + ";\n" +
            "                    while (" + numberIndexName + " < " + numberEndName +
                " && " + responseTextName + ".Item[" + numberIndexName +
                "] >= '0' && " + responseTextName + ".Item[" + numberIndexName +
                "] <= '9') " + numberIndexName + " += 1u;\n" +
            "                    if (" + numberIndexName + " == " + exponentStartName +
                ") throw new FormatException(\"REST response body is not a JSON number.\");\n" +
            "                }\n" +
            "                if (" + numberIndexName + " != " + numberEndName +
                ") throw new FormatException(\"REST response body is not a JSON number.\");\n";
        string parsedName = valueName + "Parsed";
        return numberValidationCode + "                " + sourceTypeName + "? " + parsedName +
            " = " + parserName + ".TryParse(" + responseTextName + ");\n" +
            "                if (" + parsedName +
            " == null) throw new FormatException(\"REST response body is not a valid " +
            sourceTypeName + ".\");\n" +
            "                " + sourceTypeName + " " + valueName +
            " = " + parsedName + " ?? " +
            GetNullableScalarFallback(typeIdentity) + ";\n";
    }

    private string GetRestResponseValueType(string typeIdentity) {
        string prefix = HasPrefix(typeIdentity,
            "cxnet.System.Net.Http.Rest.RestResponse<")
            ? "cxnet.System.Net.Http.Rest.RestResponse<"
            : "System.Net.Http.Rest.RestResponse<";
        if (!HasPrefix(typeIdentity, prefix) ||
            typeIdentity.Item[typeIdentity.Length - 1u] != '>') return "";
        StringBuilder valueType = new StringBuilder();
        for (uint index = prefix.Length; index < typeIdentity.Length - 1u; index += 1u)
            valueType.Append(typeIdentity.Item[index]);
        return valueType.ToString();
    }

    private TypeDescriptor FindSerializableType(string identity,
        TypeDescriptor[] types, AnnotationDescriptor[] annotations) {
        for (uint typeIndex = 0u; typeIndex < types.Length; typeIndex += 1u) {
            TypeDescriptor type = types[typeIndex];
            if (type.Kind != GeneratorValueKind.Class &&
                type.Kind != GeneratorValueKind.Struct) continue;
            if (type.IsGenericDefinition) {
                if (FindClosedGenericRequest(identity, type.Identity) == null) continue;
            } else if (type.Identity != identity) {
                continue;
            }
            List<uint> indices = _annotationIndices.GetValueOrDefault(type.Identity);
            if (indices == null) continue;
            for (uint cursor = 0u; cursor < indices.Count; cursor += 1u) {
                AnnotationDescriptor annotation = annotations[indices.Get(cursor)];
                if (annotation.TargetIdentity == type.Identity &&
                    HasSuffix(annotation.MetadataName, "System.Data.Serializable"))
                    return type;
            }
        }
        return null;
    }

    private TypeDescriptor FindRestDtoType(string identity,
        TypeDescriptor[] types, AnnotationDescriptor[] annotations) {
        TypeDescriptor serializable = FindSerializableType(identity, types, annotations);
        if (serializable != null || IsSupportedRequestValue(identity) ||
            IsByteArrayType(identity) || IsStreamType(identity) ||
            IsHttpResponseMessageType(identity) ||
            GetRestResponseValueType(identity) != "" ||
            HasPrefix(identity, "System.") ||
            HasPrefix(identity, "cxcore.System.") ||
            HasPrefix(identity, "cxnet.System.")) return serializable;
        for (uint typeIndex = 0u; typeIndex < types.Length; typeIndex += 1u) {
            TypeDescriptor type = types[typeIndex];
            if ((type.Kind != GeneratorValueKind.Class &&
                 type.Kind != GeneratorValueKind.Struct) ||
                type.Visibility != "Public") continue;
            if (type.IsGenericDefinition) {
                string[] arguments = GetClosedBaseTypeArguments(identity);
                if (arguments.Length != type.GenericParameters.Length ||
                    NormalizeTypeIdentity(GetClosedGenericIdentity(type.Identity,
                        arguments)) != NormalizeTypeIdentity(identity)) continue;
            } else if (NormalizeTypeIdentity(type.Identity) !=
                NormalizeTypeIdentity(identity)) {
                continue;
            }
            return type;
        }
        return null;
    }

    private bool IsHttpResponseMessageType(string identity) {
        return identity == "cxnet.System.Net.Http.HttpResponseMessage" ||
            identity == "System.Net.Http.HttpResponseMessage";
    }

    private ClosedGenericRequest FindClosedGenericRequest(string closedIdentity,
        string definitionIdentity) {
        Dictionary<string, ClosedGenericRequest> constructions =
            _closedGenericIndex.GetValueOrDefault(definitionIdentity);
        if (constructions == null) return null;
        return constructions.GetValueOrDefault(NormalizeTypeIdentity(closedIdentity));
    }

    private void IndexSnapshot(TypeDescriptor[] types, AnnotationDescriptor[] annotations) {
        _annotationIndices = new Dictionary<string, List<uint>>();
        for (uint index = 0u; index < annotations.Length; index += 1u) {
            string target = annotations[index].TargetIdentity;
            List<uint> indices = _annotationIndices.GetValueOrDefault(target);
            if (indices == null) {
                indices = new List<uint>();
                _annotationIndices.Set(target, indices);
            }
            // Store original positions: callers use lookup results to index the
            // snapshot, and repeated annotations must retain their source order.
            indices.Add(index);
        }
        _declaringTypeIdentities = new Dictionary<string, string>();
        for (uint typeIndex = 0u; typeIndex < types.Length; typeIndex += 1u) {
            TypeDescriptor type = types[typeIndex];
            MemberDescriptor[] members = type.Members;
            for (uint memberIndex = 0u; memberIndex < members.Length; memberIndex += 1u)
                _declaringTypeIdentities.TryAdd(members[memberIndex].Identity, type.Identity);
        }
    }

    private void IndexClosedGenericRequests() {
        _closedGenericIndex =
            new Dictionary<string, Dictionary<string, ClosedGenericRequest>>();
        for (uint index = 0u; index < _closedGenericRequests.Length; index += 1u) {
            ClosedGenericRequest request = _closedGenericRequests[index];
            Dictionary<string, ClosedGenericRequest> constructions =
                _closedGenericIndex.GetValueOrDefault(request.DefinitionIdentity);
            if (constructions == null) {
                constructions = new Dictionary<string, ClosedGenericRequest>();
                _closedGenericIndex.Set(request.DefinitionIdentity, constructions);
            }
            // Preserve snapshot order and both identity spellings accepted by
            // the linear lookup, including its first-match behavior.
            constructions.TryAdd(NormalizeTypeIdentity(request.ClosedIdentity), request);
            constructions.TryAdd(NormalizeTypeIdentity(GetClosedGenericIdentity(
                request.DefinitionIdentity, request.TypeArguments)), request);
        }
    }

    private string GetClosedGenericIdentity(string definitionIdentity,
        string[] arguments) {
        uint arityStart = definitionIdentity.Length;
        for (uint index = 0u; index < definitionIdentity.Length; index += 1u) {
            if (definitionIdentity.Item[index] == '`') { arityStart = index; break; }
        }
        StringBuilder result = new StringBuilder();
        for (uint index = 0u; index < arityStart; index += 1u)
            result.Append(definitionIdentity.Item[index]);
        result.Append('<');
        for (uint index = 0u; index < arguments.Length; index += 1u) {
            if (index != 0u) result.Append(',');
            result.Append(arguments[index]);
        }
        result.Append('>');
        return result.ToString();
    }

    private string NormalizeTypeIdentity(string identity) {
        bool needsNormalization = false;
        for (uint index = 0u; index < identity.Length; index += 1u) {
            char value = identity.Item[index];
            if (value == ' ' || value == '\t') { needsNormalization = true; break; }
        }
        if (!needsNormalization) return identity;
        StringBuilder result = new StringBuilder();
        for (uint index = 0u; index < identity.Length; index += 1u) {
            char value = identity.Item[index];
            if (value != ' ' && value != '\t') result.Append(value);
        }
        return result.ToString();
    }

    private string GetQualifiedSourceTypeName(TypeDescriptor type) {
        string name = GetSimpleName(type.MetadataName);
        return type.NamespaceName.Length == 0u ? name : type.NamespaceName + "." + name;
    }

    private string GetQualifiedSourceTypeName(TypeDescriptor type,
        string typeIdentity, TypeDescriptor[] types) {
        if (!type.IsGenericDefinition) return GetQualifiedSourceTypeName(type);
        ClosedGenericRequest request = FindClosedGenericRequest(typeIdentity,
            type.Identity);
        if (request == null) return GetQualifiedSourceTypeName(type);
        string localName = GetSimpleName(type.MetadataName);
        uint arityStart = localName.Length;
        for (uint index = 0u; index < localName.Length; index += 1u) {
            if (localName.Item[index] == '`') { arityStart = index; break; }
        }
        StringBuilder result = new StringBuilder();
        for (uint index = 0u; index < arityStart; index += 1u)
            result.Append(localName.Item[index]);
        result.Append('<');
        string[] arguments = request.TypeArguments;
        for (uint index = 0u; index < arguments.Length; index += 1u) {
            if (index != 0u) result.Append(", ");
            result.Append(GetClosedArgumentSourceName(arguments[index], types));
        }
        result.Append('>');
        string name = result.ToString();
        return type.NamespaceName.Length == 0u ? name : type.NamespaceName + "." + name;
    }

    private string GetClosedArgumentSourceName(string identity,
        TypeDescriptor[] types) {
        if (identity.Length > 2u && identity.Item[identity.Length - 2u] == '[' &&
            identity.Item[identity.Length - 1u] == ']') {
            StringBuilder arrayType = new StringBuilder();
            for (uint index = 0u; index < identity.Length - 2u; index += 1u)
                arrayType.Append(identity.Item[index]);
            return GetClosedArgumentSourceName(arrayType.ToString(), types) + "[]";
        }
        if (identity.Length > 0u && identity.Item[identity.Length - 1u] == '?') {
            StringBuilder nonNullableType = new StringBuilder();
            for (uint index = 0u; index < identity.Length - 1u; index += 1u)
                nonNullableType.Append(identity.Item[index]);
            return GetClosedArgumentSourceName(nonNullableType.ToString(), types) + "?";
        }
        if (IsSupportedRequestValue(identity)) return GetSourceParameterType(identity);
        for (uint typeIndex = 0u; typeIndex < types.Length; typeIndex += 1u) {
            TypeDescriptor type = types[typeIndex];
            if (type.Identity != identity) continue;
            if (!type.IsGenericDefinition) return GetQualifiedSourceTypeName(type);
            return GetQualifiedSourceTypeName(type, identity, types);
        }
        for (uint requestIndex = 0u; requestIndex < _closedGenericRequests.Length;
            requestIndex += 1u) {
            ClosedGenericRequest request = _closedGenericRequests[requestIndex];
            if (request.ClosedIdentity != identity) continue;
            TypeDescriptor definition = FindType(request.DefinitionIdentity, types);
            if (definition != null)
                return GetQualifiedSourceTypeName(definition, identity, types);
        }
        return identity;
    }

    private string GetJsonCodecReference(TypeDescriptor type) {
        StringBuilder name = new StringBuilder();
        for (uint index = 0u; index < type.MetadataName.Length; index += 1u) {
            char character = type.MetadataName.Item[index];
            if (character == '`') break;
            name.Append(character == '.' ? '_' : character);
        }
        name.Append("JsonCodec");
        return type.NamespaceName.Length == 0u
            ? name.ToString() : type.NamespaceName + "." + name.ToString();
    }

    private string GetJsonCodecReference(TypeDescriptor type, string typeIdentity) {
        if (!type.IsGenericDefinition) return GetJsonCodecReference(type);
        ClosedGenericRequest request = FindClosedGenericRequest(typeIdentity,
            type.Identity);
        if (request == null) return GetJsonCodecReference(type);
        StringBuilder name = new StringBuilder();
        for (uint index = 0u; index < type.MetadataName.Length; index += 1u) {
            char character = type.MetadataName.Item[index];
            if (character == '`') break;
            name.Append(character == '.' ? '_' : character);
        }
        string[] arguments = request.TypeArguments;
        for (uint argumentIndex = 0u; argumentIndex < arguments.Length;
            argumentIndex += 1u) {
            name.Append('_');
            string argument = arguments[argumentIndex];
            for (uint index = 0u; index < argument.Length; index += 1u) {
                char character = argument.Item[index];
                if ((character >= 'A' && character <= 'Z') ||
                    (character >= 'a' && character <= 'z') ||
                    (character >= '0' && character <= '9') || character == '_')
                    name.Append(character);
                else name.Append('_');
            }
        }
        name.Append("JsonCodec");
        return type.NamespaceName.Length == 0u
            ? name.ToString() : type.NamespaceName + "." + name.ToString();
    }

    private bool HasSuffix(string value, string suffix) {
        if (value.Length < suffix.Length) return false;
        uint start = value.Length - suffix.Length;
        for (uint index = 0u; index < suffix.Length; index += 1u) {
            if (value.Item[start + index] != suffix.Item[index]) return false;
        }
        return true;
    }

    private string GetSourceParameterType(string typeIdentity) {
        if (typeIdentity.Length > 0u &&
            typeIdentity.Item[typeIdentity.Length - 1u] == '?') {
            StringBuilder nullableType = new StringBuilder();
            for (uint typeIndex = 0u; typeIndex < typeIdentity.Length - 1u;
                typeIndex += 1u)
                nullableType.Append(typeIdentity.Item[typeIndex]);
            return GetSourceParameterType(nullableType.ToString()) + "?";
        }
        string collectionElementType = GetQueryCollectionElementType(typeIdentity);
        if (collectionElementType != "")
            return "IEnumerable<" + GetSourceParameterType(collectionElementType) + ">";
        string queryMapValueType = GetQueryMapValueType(typeIdentity);
        if (queryMapValueType != "")
            return "Dictionary<string, " + GetSourceParameterType(queryMapValueType) + ">";
        if (typeIdentity == "cxcore.System.Threading.Tasks.CancellationToken")
            return "CancellationToken";
        if (typeIdentity == "cxnet.System.Net.Http.HttpContent") return "HttpContent";
        if (typeIdentity == "cxcore.System.String?" || typeIdentity == "System.String?")
            return "string?";
        if (typeIdentity == "cxcore.System.String" || typeIdentity == "System.String")
            return "string";
        if (typeIdentity == "System.Char" || typeIdentity == "cxcore.System.Char")
            return "char";
        if (IsUuidType(typeIdentity)) return "Uuid";
        if (typeIdentity == "System.Bool") return "bool";
        if (typeIdentity == "System.Byte") return "byte";
        if (typeIdentity == "System.SByte") return "sbyte";
        if (typeIdentity == "System.Short") return "short";
        if (typeIdentity == "System.UShort") return "ushort";
        if (typeIdentity == "System.UInt") return "uint";
        if (typeIdentity == "System.Long") return "long";
        if (typeIdentity == "System.ULong") return "ulong";
        if (typeIdentity == "System.Float") return "float";
        if (typeIdentity == "System.Double") return "double";
        if (typeIdentity == "System.Decimal") return "decimal";
        return "int";
    }

    private string GetContractSourceParameterType(string typeIdentity) {
        if (IsNullableTypeIdentity(typeIdentity))
            return GetContractSourceParameterType(
                GetNonNullableTypeIdentity(typeIdentity)) + "?";
        if (HasPrefix(typeIdentity, "const "))
            return "const " + GetContractSourceParameterType(
                Extract(typeIdentity, 6u, typeIdentity.Length));
        string queryMapValueType = GetQueryMapValueType(typeIdentity);
        if (queryMapValueType != "")
            return "Dictionary<string, " +
                GetContractSourceParameterType(queryMapValueType) + ">";
        string collectionElementType = GetQueryCollectionElementType(typeIdentity);
        if (collectionElementType == "")
            return GetSourceParameterType(typeIdentity);
        if (IsArrayTypeIdentity(typeIdentity))
            return GetSourceParameterType(collectionElementType) + "[]";
        if (IsArrayCollectionTypeIdentity(typeIdentity))
            return "Array<" + GetSourceParameterType(collectionElementType) + ">";
        if (IsListTypeIdentity(typeIdentity))
            return "List<" + GetSourceParameterType(collectionElementType) + ">";
        if (IsLinkedListTypeIdentity(typeIdentity))
            return "LinkedList<" + GetSourceParameterType(collectionElementType) + ">";
        if (IsQueueTypeIdentity(typeIdentity))
            return "Queue<" + GetSourceParameterType(collectionElementType) + ">";
        if (IsStackTypeIdentity(typeIdentity))
            return "Stack<" + GetSourceParameterType(collectionElementType) + ">";
        bool isCollection = HasPrefix(typeIdentity,
            "System.Collections.ICollection<") ||
            HasPrefix(typeIdentity, "cxcore.System.Collections.ICollection<");
        string collectionName = isCollection ? "ICollection" : "IEnumerable";
        return collectionName + "<" +
            GetSourceParameterType(collectionElementType) + ">";
    }

    private bool IsArrayTypeIdentity(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return typeIdentity.Length > 2u &&
            typeIdentity.Item[typeIdentity.Length - 2u] == '[' &&
            typeIdentity.Item[typeIdentity.Length - 1u] == ']';
    }

    private bool IsArrayCollectionTypeIdentity(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return HasPrefix(typeIdentity, "System.Collections.Array<") ||
            HasPrefix(typeIdentity, "cxcore.System.Collections.Array<");
    }

    private bool IsRestDtoCollectionTypeIdentity(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        return IsListTypeIdentity(typeIdentity) ||
            IsLinkedListTypeIdentity(typeIdentity) ||
            IsQueueTypeIdentity(typeIdentity) ||
            IsStackTypeIdentity(typeIdentity) ||
            IsArrayCollectionTypeIdentity(typeIdentity) ||
            IsArrayTypeIdentity(typeIdentity);
    }

    private bool IsRestDtoDictionaryTypeIdentity(string typeIdentity) {
        return GetQueryMapValueType(typeIdentity) != "";
    }

    private bool IsArrayRestDtoCollectionType(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        return IsArrayCollectionTypeIdentity(typeIdentity) ||
            IsArrayTypeIdentity(typeIdentity);
    }

    private bool IsConstRestDtoCollectionType(string typeIdentity) {
        return HasPrefix(typeIdentity, "const ");
    }

    private string GetRestDtoCollectionSourceType(string typeIdentity,
        string elementTypeName) {
        bool nullable = IsNullableTypeIdentity(typeIdentity);
        string nonNullableIdentity = GetNonNullableTypeIdentity(typeIdentity);
        string qualifier = IsConstRestDtoCollectionType(nonNullableIdentity)
            ? "const " : "";
        string collectionName = IsArrayRestDtoCollectionType(nonNullableIdentity)
            ? "Array" : IsLinkedListTypeIdentity(nonNullableIdentity)
            ? "LinkedList" : IsQueueTypeIdentity(nonNullableIdentity)
            ? "Queue" : IsStackTypeIdentity(nonNullableIdentity)
            ? "Stack" : "List";
        return qualifier + collectionName + "<" + elementTypeName + ">" +
            (nullable ? "?" : "");
    }

    private string GetRestJsonValueSourceType(string typeIdentity,
        TypeDescriptor valueType, TypeDescriptor[] types) {
        string nonNullableIdentity = GetNonNullableTypeIdentity(typeIdentity);
        string sourceTypeName = valueType == null
            ? GetSourceParameterType(nonNullableIdentity)
            : GetQualifiedSourceTypeName(valueType, nonNullableIdentity, types);
        return IsNullableTypeIdentity(typeIdentity)
            ? sourceTypeName + "?" : sourceTypeName;
    }

    private string GetRestJsonMapValueSourceType(string typeIdentity,
        TypeDescriptor valueType, TypeDescriptor[] types,
        AnnotationDescriptor[] annotations) {
        string nonNullableIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (!IsRestDtoCollectionTypeIdentity(nonNullableIdentity))
            return GetRestJsonValueSourceType(typeIdentity, valueType, types);
        string elementIdentity = GetQueryCollectionElementType(
            nonNullableIdentity);
        TypeDescriptor elementType = FindRestDtoType(
            GetNonNullableTypeIdentity(elementIdentity), types, annotations);
        string elementTypeName = GetRestJsonValueSourceType(elementIdentity,
            elementType, types);
        string collectionTypeName = GetRestDtoCollectionSourceType(
            nonNullableIdentity, elementTypeName);
        return IsNullableTypeIdentity(typeIdentity)
            ? collectionTypeName + "?" : collectionTypeName;
    }

    private string GetRestDtoDictionarySourceType(string typeIdentity,
        string valueTypeName) {
        string qualifier = IsConstRestDtoCollectionType(typeIdentity)
            ? "const " : "";
        return qualifier + "Dictionary<string, " + valueTypeName + ">";
    }

    private bool IsListTypeIdentity(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return HasPrefix(typeIdentity, "System.Collections.List<") ||
            HasPrefix(typeIdentity, "cxcore.System.Collections.List<");
    }

    private bool IsLinkedListTypeIdentity(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return HasPrefix(typeIdentity, "System.Collections.LinkedList<") ||
            HasPrefix(typeIdentity, "cxcore.System.Collections.LinkedList<");
    }

    private bool IsQueueTypeIdentity(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return HasPrefix(typeIdentity, "System.Collections.Queue<") ||
            HasPrefix(typeIdentity, "cxcore.System.Collections.Queue<");
    }

    private bool IsStackTypeIdentity(string typeIdentity) {
        typeIdentity = GetNonNullableTypeIdentity(typeIdentity);
        if (HasPrefix(typeIdentity, "const "))
            typeIdentity = Extract(typeIdentity, 6u, typeIdentity.Length);
        return HasPrefix(typeIdentity, "System.Collections.Stack<") ||
            HasPrefix(typeIdentity, "cxcore.System.Collections.Stack<");
    }

    private string GetBindingName(AnnotationDescriptor annotation) {
        return GetNamedArgument(annotation, "name");
    }

    private string GetNamedArgument(AnnotationDescriptor annotation, string argumentName) {
        string[] names = annotation.ArgumentNames;
        string[] values = annotation.ArgumentValues;
        for (uint index = 0u; index < names.Length; index += 1u) {
            if (names[index] == argumentName) return values[index];
        }
        return "\"\"";
    }

    private string DecodeStringLiteral(string literal) {
        if (literal.Length < 2u || literal.Item[0u] != '"' ||
            literal.Item[literal.Length - 1u] != '"') return literal;
        StringBuilder result = new StringBuilder();
        uint index = 1u;
        while (index + 1u < literal.Length) {
            char value = literal.Item[index];
            if (value == '\\' && index + 2u < literal.Length) {
                index += 1u;
                char escaped = literal.Item[index];
                if (escaped == 'n') value = '\n';
                else if (escaped == 'r') value = '\r';
                else if (escaped == 't') value = '\t';
                else if (escaped == '0') value = '\0';
                else if (escaped == 'b') value = '\b';
                else value = escaped;
            }
            result.Append(value);
            index += 1u;
        }
        return result.ToString();
    }

    private bool IsValidMultipartDispositionParameter(string value) {
        if (value == null || value.Length == 0u) return false;
        for (uint index = 0u; index < value.Length; index += 1u) {
            char current = value.Item[index];
            if (current < ' ' || current == (char)0x7Fu ||
                current == '"' || current == '\\') return false;
        }
        return true;
    }

    private bool Contains(string value, string search) {
        if (search.Length == 0u) return true;
        if (search.Length > value.Length) return false;
        for (uint start = 0u; start + search.Length <= value.Length; start += 1u) {
            bool matches = true;
            for (uint offset = 0u; offset < search.Length; offset += 1u) {
                if (value.Item[start + offset] != search.Item[offset]) {
                    matches = false;
                    break;
                }
            }
            if (matches) return true;
        }
        return false;
    }

    private bool HasOnlyBoundPathPlaceholders(string route, string[] pathNames,
        uint pathNameCount) {
        uint index = 0u;
        while (index < route.Length) {
            if (route.Item[index] == '}') return false;
            if (route.Item[index] != '{') { index += 1u; continue; }
            uint start = index + 1u;
            uint end = start;
            while (end < route.Length && route.Item[end] != '}') {
                if (route.Item[end] == '{') return false;
                end += 1u;
            }
            if (end == route.Length || end == start) return false;
            bool found = false;
            for (uint pathIndex = 0u; pathIndex < pathNameCount; pathIndex += 1u) {
                string pathName = pathNames[pathIndex];
                if (pathName.Length != end - start) continue;
                bool matches = true;
                for (uint offset = 0u; offset < pathName.Length; offset += 1u) {
                    if (pathName.Item[offset] != route.Item[start + offset]) {
                        matches = false;
                        break;
                    }
                }
                if (matches) { found = true; break; }
            }
            if (!found) return false;
            index = end + 1u;
        }
        return true;
    }

    private string QuoteCxString(string value) {
        StringBuilder result = new StringBuilder();
        result.Append('"');
        for (uint index = 0u; index < value.Length; index += 1u) {
            char current = value.Item[index];
            if (current == '\\' || current == '"') result.Append('\\');
            result.Append(current);
        }
        result.Append('"');
        return result.ToString();
    }

    private string GetVerbName(string metadataName) {
        if (metadataName == "cxnet.System.Net.Http.Rest.Options") return "Options";
        if (metadataName == "cxnet.System.Net.Http.Rest.Post") return "Post";
        if (metadataName == "cxnet.System.Net.Http.Rest.Put") return "Put";
        if (metadataName == "cxnet.System.Net.Http.Rest.Patch") return "Patch";
        if (metadataName == "cxnet.System.Net.Http.Rest.Delete") return "Delete";
        if (metadataName == "cxnet.System.Net.Http.Rest.Head") return "Head";
        return "Get";
    }

    private string GetVerbToken(string verbName) {
        if (verbName == "Get") return "GET";
        if (verbName == "Post") return "POST";
        if (verbName == "Put") return "PUT";
        if (verbName == "Patch") return "PATCH";
        if (verbName == "Delete") return "DELETE";
        if (verbName == "Head") return "HEAD";
        if (verbName == "Options") return "OPTIONS";
        return "GET";
    }

    private string GetRoute(AnnotationDescriptor annotation) {
        string[] names = annotation.ArgumentNames;
        string[] values = annotation.ArgumentValues;
        for (uint index = 0u; index < names.Length; index += 1u) {
            if (names[index] == "route") return values[index];
        }
        return "\"\"";
    }
}
